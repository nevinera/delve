{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ability.schema.json",
  "title": "abilities/<id>.json",
  "description": "Something a class or creature can do.",
  "type": "object",
  "required": [
    "id",
    "name",
    "target",
    "effects"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "replaces": {
      "$ref": "common.schema.json#/$defs/id",
      "description": "knowing this ability takes that one off your bar"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "school": {
      "$ref": "common.schema.json#/$defs/school"
    },
    "schools": {
      "$ref": "common.schema.json#/$defs/schools"
    },
    "target": {
      "enum": [
        "enemy",
        "ally",
        "any",
        "self",
        "ground",
        "none"
      ]
    },
    "range": {
      "$ref": "common.schema.json#/$defs/distance"
    },
    "minRange": {
      "type": "number",
      "minimum": 0
    },
    "facing": {
      "type": "boolean"
    },
    "requires": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/condition"
      }
    },
    "creatureTypes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/creatureType"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "castTime": {
      "type": "number",
      "minimum": 0
    },
    "castWhileMoving": {
      "type": "boolean"
    },
    "whileCasting": {
      "type": "boolean",
      "description": "you can use it while casting something else"
    },
    "channel": {
      "type": "object",
      "required": [
        "duration",
        "ticks"
      ],
      "properties": {
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ticks": {
          "type": "integer",
          "minimum": 1
        },
        "effect": {
          "$ref": "common.schema.json#/$defs/effect",
          "description": "what each tick does, when that isn't the ability's effects"
        },
        "costPerTick": {
          "type": "object",
          "required": [
            "resource",
            "amount"
          ],
          "additionalProperties": false,
          "properties": {
            "resource": {
              "type": "string"
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "description": "what each tick spends. It ends when you can't pay"
        }
      }
    },
    "gcd": {
      "type": "number",
      "minimum": 0
    },
    "gcdHasted": {
      "type": "boolean"
    },
    "cooldown": {
      "type": "number",
      "minimum": 0
    },
    "charges": {
      "type": "integer",
      "minimum": 1
    },
    "cooldownHasted": {
      "type": "boolean"
    },
    "cost": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resource"
        ],
        "properties": {
          "resource": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "percent": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "all": {
            "type": "boolean",
            "description": "spends all you have of the resource, needing at least `amount` or `percent`"
          },
          "upTo": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "it spends more if you have it, up to this much in all"
          },
          "perSecond": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "it spends this much each second while it channels, in place of amount"
          },
          "when": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/condition"
            },
            "description": "this cost only counts while these hold"
          }
        },
        "oneOf": [
          {
            "required": [
              "amount"
            ]
          },
          {
            "required": [
              "percent"
            ]
          },
          {
            "required": [
              "perSecond"
            ]
          }
        ]
      }
    },
    "speed": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/effect"
      }
    },
    "visuals": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/visual"
      }
    },
    "sounds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sound"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string",
      "description": "free-form notes on intent and backstory; the game never reads them"
    }
  }
}
