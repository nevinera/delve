{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "class.schema.json",
  "title": "classes/<id>.json",
  "description": "A class players can pick, holding its own abilities and statuses. Only its id and name are required, so the class editor can save one as it's built; what the game needs to play one comes later.",
  "type": "object",
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "colors": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "$ref": "common.schema.json#/$defs/color"
        },
        "minor": {
          "$ref": "common.schema.json#/$defs/color"
        }
      }
    },
    "primaryStats": {
      "type": "array",
      "items": {
        "enum": [
          "strength",
          "agility",
          "intellect"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/resource"
      },
      "minItems": 1,
      "maxItems": 3,
      "description": "the first is the primary resource"
    },
    "armor": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "level"
        ],
        "properties": {
          "type": {
            "$ref": "common.schema.json#/$defs/armorType"
          },
          "level": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "weapons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "weapon types from weapons.js's HELD"
    },
    "offhands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "abilities": {
      "type": "array",
      "description": "What the class can do: abilities, each with the level it's granted at.",
      "items": {
        "allOf": [
          {
            "$ref": "ability.schema.json"
          },
          {
            "type": "object",
            "required": [
              "level"
            ],
            "properties": {
              "level": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        ]
      }
    },
    "statuses": {
      "type": "array",
      "description": "The statuses its abilities, passives and mastery apply. Effects point at them by id.",
      "items": {
        "$ref": "status.schema.json"
      }
    },
    "units": {
      "type": "array",
      "description": "what the class summons, written out here",
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "passives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "status",
          "level"
        ],
        "properties": {
          "status": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "level": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "mastery": {
      "type": "object",
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/id"
        }
      }
    },
    "startingGear": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string",
      "description": "free-form notes on intent and backstory; the game never reads them"
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "creatureType": {
          "$ref": "creature.schema.json#/properties/creatureType"
        },
        "reach": {
          "$ref": "creature.schema.json#/properties/reach"
        },
        "look": {
          "$ref": "creature.schema.json#/properties/look"
        },
        "attack": {
          "$ref": "creature.schema.json#/properties/attack"
        },
        "speed": {
          "$ref": "creature.schema.json#/properties/speed"
        },
        "power": {
          "type": "object",
          "additionalProperties": false,
          "description": "shares of its summoner's",
          "properties": {
            "attackPower": {
              "type": "number",
              "minimum": 0
            },
            "spellPower": {
              "type": "number",
              "minimum": 0
            },
            "health": {
              "type": "number",
              "minimum": 0
            },
            "armor": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "abilities": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "description": "from the same class"
        },
        "autocast": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "description": "which of its abilities it uses on its own, for one that obeys"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
