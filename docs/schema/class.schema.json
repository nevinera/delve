{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "class.schema.json",
  "title": "classes/<id>.json",
  "description": "A class players can pick, holding its own abilities and statuses. Only its id and name are required, so the class editor can save one as it's built; what the game needs to play one comes later.",
  "type": "object",
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "colors": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "$ref": "common.schema.json#/$defs/color"
        },
        "minor": {
          "$ref": "common.schema.json#/$defs/color"
        }
      }
    },
    "primaryStats": {
      "type": "array",
      "items": {
        "enum": [
          "strength",
          "agility",
          "intellect"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/resource"
      },
      "minItems": 1,
      "maxItems": 3,
      "description": "the first is the primary resource"
    },
    "armor": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "level"
        ],
        "properties": {
          "type": {
            "$ref": "common.schema.json#/$defs/armorType"
          },
          "level": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "weapons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "weapon types from weapons.js's HELD"
    },
    "offhands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "startingGear": {
      "type": "object",
      "description": "What it holds before a specialization asks for something else. Either one left out is the first in its list.",
      "properties": {
        "weapon": {
          "type": "string",
          "description": "one of its weapons"
        },
        "offhand": {
          "type": "string",
          "description": "one of its offhands, or none"
        }
      }
    },
    "abilities": {
      "type": "array",
      "description": "What the class can do: abilities, each with the level it's granted at.",
      "items": {
        "allOf": [
          {
            "$ref": "ability.schema.json"
          },
          {
            "type": "object",
            "required": [
              "level"
            ],
            "properties": {
              "level": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        ]
      }
    },
    "statuses": {
      "type": "array",
      "description": "The statuses its abilities, passives and mastery apply. Effects point at them by id.",
      "items": {
        "$ref": "status.schema.json"
      }
    },
    "units": {
      "type": "array",
      "description": "what the class summons, written out here",
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "specializations": {
      "type": "array",
      "description": "what a character picks at the level the game sets",
      "items": {
        "$ref": "#/$defs/specialization"
      }
    },
    "talents": {
      "type": "object",
      "description": "what a character picks from, one per tier, by the level of the tier",
      "additionalProperties": false,
      "patternProperties": {
        "^[1-9][0-9]*$": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/talent"
          }
        }
      }
    },
    "passives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "status",
          "level"
        ],
        "properties": {
          "status": {
            "$ref": "common.schema.json#/$defs/id",
            "x-refers": "status"
          },
          "level": {
            "type": "integer",
            "minimum": 1
          }
        },
        "x-what": "A passive"
      }
    },
    "mastery": {
      "type": "object",
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/id",
          "x-refers": "status"
        }
      },
      "x-what": "The mastery"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string",
      "description": "free-form notes on intent and backstory; the game never reads them"
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "creatureType": {
          "$ref": "creature.schema.json#/properties/creatureType"
        },
        "reach": {
          "$ref": "creature.schema.json#/properties/reach"
        },
        "look": {
          "$ref": "creature.schema.json#/properties/look"
        },
        "attack": {
          "$ref": "creature.schema.json#/properties/attack"
        },
        "speed": {
          "$ref": "creature.schema.json#/properties/speed"
        },
        "power": {
          "type": "object",
          "additionalProperties": false,
          "description": "shares of its summoner's",
          "properties": {
            "attackPower": {
              "type": "number",
              "minimum": 0
            },
            "spellPower": {
              "type": "number",
              "minimum": 0
            },
            "health": {
              "type": "number",
              "minimum": 0
            },
            "armor": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "abilities": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id",
            "x-refers": "ability"
          },
          "description": "from the same class"
        },
        "autocast": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "description": "which of its abilities it uses on its own, for one that obeys"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "x-what": "A unit"
    },
    "specialization": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/id",
          "description": "a status it has for as long as it's this, so effects can ask with when",
          "x-refers": "status"
        },
        "abilities": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id",
            "x-refers": "ability"
          },
          "description": "abilities only it gets"
        }
      },
      "x-what": "A specialization"
    },
    "talent": {
      "type": "object",
      "required": [
        "id",
        "name",
        "grants"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "requires": {
          "$ref": "common.schema.json#/$defs/id",
          "description": "a talent in the tier directly above that you have to have picked"
        },
        "grants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "$ref": "common.schema.json#/$defs/id",
                "x-refers": "status"
              },
              "ability": {
                "$ref": "common.schema.json#/$defs/id",
                "x-refers": "ability"
              },
              "spec": {
                "type": "string",
                "description": "only for this specialization",
                "x-refers": "specialization"
              }
            }
          }
        }
      },
      "x-what": "A talent"
    }
  }
}
