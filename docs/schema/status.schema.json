{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "status.schema.json",
  "title": "statuses/<id>.json",
  "description": "A buff, debuff or hidden effect on a unit.",
  "type": "object",
  "required": [
    "id",
    "name",
    "kind",
    "effects"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "buff",
        "debuff",
        "hidden"
      ]
    },
    "dispel": {
      "enum": [
        "magic",
        "curse",
        "poison",
        "disease",
        "enrage"
      ]
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "stacking": {
      "enum": [
        "refresh",
        "replace",
        "stack"
      ]
    },
    "maxStacks": {
      "type": "integer",
      "minimum": 1
    },
    "breaksOn": {
      "type": "array",
      "items": {
        "enum": [
          "move",
          "damage",
          "action"
        ]
      },
      "uniqueItems": true
    },
    "consumedBy": {
      "type": "object",
      "description": "it ends when the holder uses one of these abilities, by id from the same class, or with this tag",
      "properties": {
        "abilities": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "tag": {
          "type": "string"
        },
        "uses": {
          "type": "integer",
          "minimum": 1,
          "description": "how many uses it lasts, 1 by default. These aren't stacks: its effects don't scale with them"
        },
        "stacks": {
          "type": "integer",
          "minimum": 1,
          "description": "takes this many stacks each use, instead of ending"
        }
      }
    },
    "pose": {
      "enum": [
        "sit"
      ]
    },
    "aura": {
      "type": "object",
      "required": [
        "effect"
      ],
      "properties": {
        "effect": {
          "type": "string"
        },
        "colors": {
          "$ref": "common.schema.json#/$defs/colors"
        }
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "stat",
              "periodic",
              "absorb",
              "control",
              "trigger",
              "stealth",
              "modify",
              "immune",
              "none"
            ]
          },
          "stat": {
            "$ref": "common.schema.json#/$defs/anyStat"
          },
          "add": {
            "type": "number"
          },
          "multiply": {
            "type": "number"
          },
          "set": {
            "type": "number",
            "description": "modify: makes it this. Applied before `add` and `multiply`"
          },
          "school": {
            "$ref": "common.schema.json#/$defs/school"
          },
          "category": {
            "type": "string",
            "description": "periodic: a word the class picks, like bleed or disease. On a stat or trigger: only for that category"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "stat or trigger: only for these categories"
          },
          "every": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "does": {
            "enum": [
              "damage",
              "heal",
              "resource"
            ]
          },
          "amount": {
            "$ref": "common.schema.json#/$defs/amount"
          },
          "resource": {
            "type": "string",
            "description": "trigger, for spend: only spending this resource, by key"
          },
          "schools": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/school"
            }
          },
          "control": {
            "enum": [
              "stun",
              "root",
              "silence",
              "incapacitate",
              "disorient",
              "fear",
              "disarm"
            ]
          },
          "controls": {
            "type": "array",
            "items": {
              "enum": [
                "stun",
                "root",
                "silence",
                "incapacitate",
                "disorient",
                "fear",
                "disarm",
                "slow",
                "interrupt",
                "knockback",
                "pull",
                "pushback",
                "charm",
                "sleep"
              ]
            },
            "description": "immune: these kinds of control"
          },
          "all": {
            "type": "boolean",
            "description": "immune: to all damage and harmful effects"
          },
          "harmful": {
            "type": "boolean",
            "description": "immune: to harmful statuses"
          },
          "on": {
            "enum": [
              "dealDamage",
              "takeDamage",
              "heal",
              "crit",
              "cast",
              "dodge",
              "parry",
              "block",
              "healthBelow",
              "statusGained",
              "statusConsumed",
              "statusEnds",
              "holderDies",
              "kill",
              "dispel",
              "dispelled",
              "interrupt",
              "channelEnd",
              "wouldDie",
              "pickup",
              "spend",
              "overheal",
              "nonCrit",
              "healed",
              "allyHealthBelow"
            ]
          },
          "hit": {
            "enum": [
              "auto",
              "ability",
              "melee",
              "direct",
              "area",
              "main",
              "others",
              "single",
              "periodic"
            ],
            "description": "stat, trigger or modify: only for this kind of hit"
          },
          "source": {
            "enum": [
              "self",
              "summons",
              "both"
            ],
            "description": "stat or trigger: whose it is, the holder's by default"
          },
          "units": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "description": "with source: only these units"
          },
          "atTargets": {
            "type": "integer",
            "minimum": 2,
            "description": "trigger or modify: only when the ability hits at least this many"
          },
          "casterOnly": {
            "type": "boolean",
            "description": "stat or trigger, on a status you put on someone: only for what passes between its holder and the one who applied it"
          },
          "threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "percent, for healthBelow and allyHealthBelow"
          },
          "atStacks": {
            "type": "integer",
            "minimum": 1,
            "description": "trigger, for statusGained or statusConsumed: only when the status has at least this many stacks"
          },
          "full": {
            "type": "boolean",
            "description": "trigger, for channelEnd: only when the channel runs its whole length"
          },
          "pickup": {
            "type": "string",
            "description": "trigger, for pickup or overheal: only this kind of pickup"
          },
          "chance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "chancePerSpent": {
            "type": "number",
            "minimum": 0,
            "description": "trigger: more chance for each point the ability spends"
          },
          "cooldown": {
            "type": "number",
            "minimum": 0
          },
          "effect": {
            "$ref": "common.schema.json#/$defs/effect"
          },
          "when": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/condition"
            }
          },
          "addPerSpent": {
            "type": "number",
            "description": "stat: `add` more for each point the ability that applied it spent"
          },
          "multiplyPerSpent": {
            "type": "number",
            "description": "stat: added to `multiply` for each point the ability that applied it spent"
          },
          "abilities": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "description": "modify: the abilities it changes. trigger: only for these. By id, from the same class"
          },
          "tag": {
            "type": "string",
            "description": "modify: changes every ability with this tag. trigger: only for abilities with this tag"
          },
          "statuses": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "description": "modify: the statuses it changes. trigger: only for these. By id, from the same class"
          },
          "change": {
            "type": "string",
            "description": "modify: what changes, one of cost, cooldown, cooldownRate, castTime, charges, range, radius, maxTargets, duration, damage, healing, critChance, critDamage, maxStacks, or a param its target names"
          },
          "addEffects": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/effect"
            },
            "description": "modify: effects the abilities also do"
          },
          "statusEffects": {
            "type": "array",
            "items": {
              "$ref": "#/properties/effects/items"
            },
            "description": "modify of `statuses`: effects they also have"
          },
          "param": {
            "type": "string",
            "description": "names this effect's number, so a modify can change it"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "free-form notes on intent and backstory; the game never reads them"
    }
  }
}
