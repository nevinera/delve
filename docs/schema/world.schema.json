{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world.schema.json",
  "title": "world.json",
  "description": "The world's name, continents and dungeons, at the world's root.",
  "type": "object",
  "required": [
    "version",
    "name",
    "continents"
  ],
  "properties": {
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "name": {
      "type": "string"
    },
    "continents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "name"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[\\w-]+$"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "dungeons": {
      "type": "array"
    },
    "levelCap": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "description": "the highest level characters reach here, 20 by default"
    },
    "notes": {
      "type": "string",
      "description": "free-form notes on intent and backstory, for whoever builds the world; the game never reads them"
    },
    "spawn": {
      "type": "object",
      "required": [
        "continent",
        "at"
      ],
      "description": "version 2: where characters new to the world start, set in /create",
      "properties": {
        "continent": {
          "type": "string",
          "description": "a continent's key"
        },
        "at": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[x, z] in continent feet"
        }
      }
    },
    "dummies": {
      "type": "array",
      "description": "version 2: training dummies the game server puts up, set in /create",
      "items": {
        "type": "object",
        "required": [
          "continent",
          "at"
        ],
        "properties": {
          "continent": {
            "type": "string",
            "description": "a continent's key"
          },
          "at": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "[x, z] in continent feet"
          }
        }
      }
    },
    "restPoints": {
      "type": "array",
      "description": "version 2: rest points, which characters make their home and Homeward takes them back to, set in /create",
      "items": {
        "type": "object",
        "required": [
          "id",
          "continent",
          "at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "never changes once made; characters' homes keep it"
          },
          "name": {
            "type": "string",
            "description": "what players see, such as \"The Inn\""
          },
          "continent": {
            "type": "string",
            "description": "a continent's key"
          },
          "at": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "[x, z] in continent feet"
          }
        }
      }
    }
  }
}
