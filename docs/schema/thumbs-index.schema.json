{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thumbs-index.schema.json",
  "title": "thumbs/index.json",
  "description": "What each tile's thumbnail was drawn from, at places/continents/<c>/thumbs/index.json, so a changed tile is drawn again.",
  "type": "object",
  "required": [
    "version",
    "px",
    "chunk",
    "tiles"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "px": {
      "type": "integer",
      "description": "pixels a tile"
    },
    "chunk": {
      "type": "integer",
      "description": "tiles across each PNG"
    },
    "tiles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^-?\\d+,-?\\d+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "print"
        ],
        "properties": {
          "print": {
            "type": "string",
            "description": "fingerprint of the tile file the picture came from"
          }
        }
      }
    }
  }
}
