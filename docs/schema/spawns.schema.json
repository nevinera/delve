{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spawns.schema.json",
  "title": "places/continents/<c>/spawns.json",
  "description": "A continent's spawn areas, and the mobs and NPCs placed one at a time.",
  "type": "object",
  "required": [
    "version",
    "placed"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "spawnAreas": {
      "type": "array",
      "description": "/create's spawn areas: each scatters placed mobs inside an area; the game server only reads the placed mobs",
      "items": {
        "type": "object",
        "required": [
          "id",
          "area",
          "spawns"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "area": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "the area, in the continent's regions.json, it scatters mobs inside"
          },
          "notes": {
            "type": "string",
            "description": "free-form notes on intent and backstory; the game never reads them"
          },
          "spawns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "creature",
                "density",
                "levels"
              ],
              "properties": {
                "creature": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "density": {
                  "type": "number",
                  "minimum": 0,
                  "description": "mobs per 512 ft square"
                },
                "pack": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "levels": {
                  "$ref": "common.schema.json#/$defs/levels"
                },
                "respawn": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "wander": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "placed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "at"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "creature": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "npc": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "at": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "yaw": {
            "type": "number"
          },
          "levels": {
            "$ref": "common.schema.json#/$defs/levels"
          },
          "respawn": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "wander": {
            "type": "number",
            "minimum": 0
          },
          "notes": {
            "type": "string",
            "description": "free-form notes on intent and backstory; the game never reads them"
          },
          "pack": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "patrol": {
            "type": "object",
            "required": [
              "points"
            ],
            "properties": {
              "points": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 2
              },
              "loop": {
                "type": "boolean"
              }
            }
          },
          "spawnArea": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "the spawn area that scattered this mob; /create scatters it again with the rest, until it's edited by hand"
          }
        },
        "oneOf": [
          {
            "required": [
              "creature"
            ]
          },
          {
            "required": [
              "npc"
            ]
          }
        ]
      }
    },
    "notes": {
      "type": "string",
      "description": "free-form notes on intent and backstory; the game never reads them"
    }
  }
}
