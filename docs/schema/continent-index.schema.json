{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continent-index.schema.json",
  "title": "index.json",
  "description": "Which tiles a continent has, the layers each has, and the zones touching each, at places/continents/<c>/index.json. The editor rebuilds it from the world's files.",
  "type": "object",
  "required": [
    "version",
    "tiles"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "tiles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^-?\\d+,-?\\d+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "zones",
          "layers"
        ],
        "properties": {
          "zones": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[\\w-]+$"
            }
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[\\w-]+$"
            }
          }
        }
      }
    }
  }
}
