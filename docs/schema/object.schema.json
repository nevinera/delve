{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "object.schema.json",
  "title": "objects/<id>.json",
  "description": "A built object: a kind of object put together from primitive pieces. Placed as \"built:<id>\".",
  "type": "object",
  "required": [
    "id",
    "name",
    "palette",
    "pieces"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-z]{8}$"
    },
    "name": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "collection": {
      "type": "string",
      "pattern": "^[0-9a-z]{8}$",
      "description": "the collection it's in"
    },
    "source": {
      "type": "string"
    },
    "variantSet": {
      "type": "string",
      "minLength": 1,
      "description": "the variant set it's in: objects in one collection with the same name are variants, and /create switches to a random other after each placing"
    },
    "walkThrough": {
      "const": true,
      "description": "true for an object characters walk through; it stands in the way when absent"
    },
    "blocksSight": {
      "const": false,
      "description": "false for an object you see through; it blocks line of sight when absent"
    },
    "sightCuts": {
      "type": "array",
      "maxItems": 16,
      "description": "holes through what blocks sight: each outline swept right through, along a direction or out from a point of view",
      "items": {
        "type": "object",
        "required": [
          "outline"
        ],
        "oneOf": [
          {
            "required": [
              "along"
            ]
          },
          {
            "required": [
              "from"
            ]
          }
        ],
        "properties": {
          "along": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "swept straight through both ways along this direction"
          },
          "from": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "swept out from this point of view as a cone, feet from the object's centre"
          },
          "outline": {
            "type": "array",
            "minItems": 3,
            "maxItems": 32,
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "description": "feet from the object's centre"
          }
        }
      }
    },
    "palette": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "color"
        ],
        "properties": {
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "param": {
            "type": "boolean",
            "description": "a placement can override it"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "pieces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "size",
          "at",
          "turn",
          "color"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "size": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "bounding box, feet"
          },
          "at": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "middle, feet from the object's centre on the ground; y up, x east, z south"
          },
          "turn": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "[yaw, pitch, roll] degrees, applied roll, pitch, yaw"
          },
          "color": {
            "type": "integer",
            "description": "index into palette"
          },
          "taper": {
            "type": "number"
          },
          "cut": {
            "type": "boolean",
            "description": "a hole, taken out of the other pieces"
          },
          "decals": {
            "type": "array"
          },
          "texts": {
            "type": "array"
          },
          "tile": {
            "type": "object"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "free-form notes on intent and backstory, for whoever builds the world; the game never reads them"
    }
  }
}
