{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cave-layout.schema.json",
  "title": "caves/layout.json",
  "description": "A continent's planned cave rooms and tunnels, at places/continents/<c>/caves/layout.json.",
  "type": "object",
  "required": ["version", "nodes", "arcs"],
  "properties": {
    "version": { "const": 2 },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "arcs": { "type": "array", "items": { "$ref": "#/$defs/arc" } },
    "carved": {
      "type": "object",
      "description": "Each node or arc by id as it was when last carved; an arc's copy adds ends.",
      "additionalProperties": { "type": "object" }
    }
  },
  "$defs": {
    "point": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "rock": { "type": "integer", "minimum": 0, "maximum": 3, "description": "0 jagged, 1 smooth, 2 carved, 3 mined" },
    "style": { "enum": ["mineshaft", "borehole", "lavatube"] },
    "node": {
      "type": "object",
      "required": ["id", "at"],
      "properties": {
        "id": { "type": "string", "pattern": "^n\\d+$" },
        "at": { "$ref": "#/$defs/point", "description": "the middle of the room's floor, in feet" },
        "size": { "enum": ["s", "m", "l", "xl", "xxl", "3xl", "4xl"] },
        "shape": { "enum": ["cathedral", "round", "flat", "entrance"] },
        "style": { "description": "a room's style, or an entrance's: natural or mine", "anyOf": [{ "$ref": "#/$defs/style" }, { "enum": ["natural", "mine"] }] },
        "rock": { "$ref": "#/$defs/rock" },
        "hewn": { "type": "boolean" },
        "locked": { "type": "boolean", "description": "kept from being moved, changed or deleted, so it isn't carved again" },
        "mouth": { "$ref": "#/$defs/point", "description": "an entrance's: the middle of its mouth's floor" },
        "yaw": { "type": "number", "description": "an entrance's: the way it runs in, degrees, 0 toward +z" },
        "length": { "enum": [16, 32, 48, 64], "description": "an entrance's: how far in its far end is, feet across" },
        "slope": { "enum": ["level", "down"], "description": "an entrance's: down drops 1 ft for every 5 in" },
        "width": { "type": "number", "minimum": 6, "maximum": 24, "description": "an entrance's tube's width and height, feet" }
      }
    },
    "arc": {
      "type": "object",
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "type": "string", "pattern": "^a\\d+$" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "bends": { "type": "array", "items": { "$ref": "#/$defs/point" } },
        "size": { "type": "number", "minimum": 4, "maximum": 60, "description": "width in feet" },
        "shape": { "enum": ["straight", "wiggly", "zigzag", "deadends"] },
        "style": { "$ref": "#/$defs/style" },
        "rock": { "$ref": "#/$defs/rock" },
        "hewn": { "type": "boolean" },
        "locked": { "type": "boolean", "description": "kept from being moved, changed or deleted, so it isn't carved again" }
      }
    }
  }
}
