{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cave-layout.schema.json",
  "title": "caves/layout.json",
  "description": "A continent's cave networks and what's laid out in them, at places/continents/<c>/caves/layout.json.",
  "type": "object",
  "required": ["version", "networks", "entrances", "points", "segments"],
  "properties": {
    "version": { "const": 2 },
    "networks": { "type": "array", "items": { "$ref": "#/$defs/network" } },
    "entrances": { "type": "array", "items": { "$ref": "#/$defs/entrance" } },
    "points": { "type": "array", "items": { "$ref": "#/$defs/point" } },
    "segments": { "type": "array", "items": { "$ref": "#/$defs/segment" } },
    "carved": {
      "type": "object",
      "description": "Each entrance or segment by id as it was when last carved; a segment's copy adds ends, copies of its points, and near, copies of the points within 3 segments of them.",
      "additionalProperties": { "type": "object" }
    }
  },
  "$defs": {
    "xyz": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "rock": { "type": "integer", "minimum": 0, "maximum": 3, "description": "0 jagged, 1 smooth, 2 carved, 3 mined" },
    "network": {
      "type": "object",
      "required": ["slug"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "phase": { "enum": ["layout", "polish"] }
      }
    },
    "entrance": {
      "type": "object",
      "required": ["id", "net", "mouth", "yaw", "point"],
      "properties": {
        "id": { "type": "string", "pattern": "^e\\d+$" },
        "net": { "$ref": "#/$defs/slug" },
        "mouth": { "$ref": "#/$defs/xyz", "description": "the middle of its mouth's floor" },
        "yaw": { "type": "number", "description": "the way it runs in, degrees, 0 toward +z" },
        "length": { "enum": [16, 32, 48, 64], "description": "how far in its far end is, feet across" },
        "slope": { "enum": ["level", "down"], "description": "down drops 1 ft for every 5 in" },
        "width": { "type": "number", "minimum": 16, "maximum": 24, "description": "its tube's width and height, feet" },
        "style": { "enum": ["natural", "mine"] },
        "rock": { "$ref": "#/$defs/rock" },
        "point": { "type": "string", "description": "the point at its far end" }
      }
    },
    "point": {
      "type": "object",
      "required": ["id", "net", "at"],
      "properties": {
        "id": { "type": "string", "pattern": "^p\\d+$" },
        "net": { "$ref": "#/$defs/slug" },
        "at": { "$ref": "#/$defs/xyz", "description": "the middle of the passage's floor, feet" },
        "width": { "type": "number", "description": "the passage's width, feet" },
        "height": { "type": "number", "description": "the passage's height, feet" },
        "qualities": { "type": "array", "items": { "enum": ["twisty", "very twisty", "bumpy", "ledges", "cluttered", "offshoots", "switchbacks"] } },
        "rock": { "$ref": "#/$defs/rock" }
      }
    },
    "segment": {
      "type": "object",
      "required": ["id", "net", "from", "to"],
      "properties": {
        "id": { "type": "string", "pattern": "^s\\d+$" },
        "net": { "$ref": "#/$defs/slug" },
        "from": { "type": "string" },
        "to": { "type": "string" }
      }
    }
  }
}
