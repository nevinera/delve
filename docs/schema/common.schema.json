            "type": "string"
          },
          "minItems": 1,
          "description": "dispel: removes statuses with one of these tags"
        },
        "perTargetHit": {
          "type": [
            "boolean",
            "number"
          ],
          "description": "true: its amount, or a cooldown effect's by, counts once for each one the ability hits. A number: that share more for each one"
        },
        "share": {
          "type": "number",
          "description": "extraTargets: the share of the hit the others take"
        },
        "spendsStack": {
          "type": [
            "boolean",
            "string"
