{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "common definitions",
  "description": "Types the game data files share (.agents/formats.md).",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-z]{8}$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "colors": {
      "type": "array",
      "description": "[main, trim]",
      "items": {
        "$ref": "#/$defs/color"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "range": {
      "type": "array",
      "description": "[min, max]",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "numberOrRange": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/range"
        }
      ]
    },
    "levels": {
      "description": "a level, or [min, max]",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "amount": {
      "description": "a number, [min, max], or parts that add up",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/range"
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "base": {
              "$ref": "#/$defs/numberOrRange"
            },
            "attackPower": {
              "type": "number"
            },
            "spellPower": {
              "type": "number"
            },
            "weapon": {
              "type": "number"
            },
            "mastery": {
              "type": "number"
            },
            "byMastery": {
              "type": "number",
              "description": "makes the whole amount bigger: it grows by this many percent for each point of the caster's mastery percentage"
            },
            "maxHealth": {
              "type": "number",
              "description": "a share of the maximum health of whoever it affects"
            },
            "shareOfTrigger": {
              "type": "number",
              "description": "a share of the hit or heal that set off the trigger or applied the status"
            },
            "shareOf": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "of",
                "share"
              ],
              "description": "a share of something the fight has kept track of",
              "properties": {
                "of": {
                  "enum": [
                    "recentDamage",
                    "stored",
                    "statusLeft",
                    "effect",
                    "casterMaxHealth",
                    "unitMaxHealth",
                    "maxResource",
                    "healthSpent"
                  ]
                },
                "share": {
                  "type": "number"
                },
                "seconds": {
                  "type": "number",
                  "minimum": 0,
                  "description": "recentDamage: how far back"
                },
                "on": {
                  "enum": [
                    "self",
                    "target"
                  ],
                  "description": "recentDamage: who took it, self by default"
                },
                "statuses": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/id",
                    "x-refers": "status"
                  },
                  "description": "statusLeft: which, by default the one that set off the trigger"
                },
                "resource": {
                  "type": "string",
                  "description": "maxResource: which",
                  "x-refers": "resource"
                }
              }
            },
            "minimum": {
              "$ref": "#/$defs/amount",
              "description": "it never comes to less than this"
            },
            "maximum": {
              "$ref": "#/$defs/amount",
              "description": "it never comes to more than this"
            },
            "byMissingHealth": {
              "$ref": "#/$defs/byMissingHealth"
            },
            "perSpent": {
              "$ref": "#/$defs/amount",
              "description": "more for each point the ability spends with an `all` cost, or that the ability which applied the status spent"
            }
          }
        }
      ]
    },
    "distance": {
      "description": "feet, or \"melee\"",
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "const": "melee"
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "health"
          ],
          "additionalProperties": false,
          "properties": {
            "health": {
              "enum": [
                "self",
                "target"
              ]
            },
            "below": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "above": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "oneOf": [
            {
              "required": [
                "below"
              ]
            },
            {
              "required": [
                "above"
              ]
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "status",
            "on"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "$ref": "#/$defs/id",
              "x-refers": "status"
            },
            "on": {
              "enum": [
                "self",
                "target"
              ]
            },
            "stacks": {
              "type": "integer",
              "minimum": 1,
              "description": "at least this many stacks of it"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "stealthed"
          ],
          "additionalProperties": false,
          "properties": {
            "stealthed": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "inCombat"
          ],
          "additionalProperties": false,
          "properties": {
            "inCombat": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "anyOf"
          ],
          "additionalProperties": false,
          "properties": {
            "anyOf": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/condition"
              },
              "description": "holds when any of these does"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/condition",
              "description": "holds when this doesn't"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "targetIs"
          ],
          "additionalProperties": false,
          "properties": {
            "targetIs": {
              "enum": [
                "enemy",
                "ally",
                "self",
                "other",
                "player",
                "nonPlayer"
              ],
              "description": "what the ability is used on"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "state"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "casting",
                "inCombat",
                "slowed",
                "airborne",
                "falling",
                "controlled",
                "stunned",
                "outdoors"
              ]
            },
            "on": {
              "enum": [
                "self",
                "target"
              ],
              "description": "self by default"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "position"
          ],
          "additionalProperties": false,
          "properties": {
            "position": {
              "enum": [
                "behind",
                "inFront"
              ],
              "description": "where you stand from the target"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "since"
          ],
          "additionalProperties": false,
          "properties": {
            "since": {
              "enum": [
                "stealth",
                "attack",
                "damageTaken",
                "kill",
                "combatStart"
              ],
              "description": "seconds since this last happened to or by you"
            },
            "below": {
              "type": "number",
              "minimum": 0
            },
            "above": {
              "type": "number",
              "minimum": 0
            }
          },
          "oneOf": [
            {
              "required": [
                "below"
              ]
            },
            {
              "required": [
                "above"
              ]
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "resource"
          ],
          "additionalProperties": false,
          "properties": {
            "resource": {
              "type": "string",
              "x-refers": "resource"
            },
            "below": {
              "type": "number",
              "minimum": 0
            },
            "above": {
              "type": "number",
              "minimum": 0
            },
            "percent": {
              "type": "boolean",
              "description": "below and above are percent of its maximum"
            }
          },
          "oneOf": [
            {
              "required": [
                "below"
              ]
            },
            {
              "required": [
                "above"
              ]
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "holders"
          ],
          "additionalProperties": false,
          "properties": {
            "holders": {
              "$ref": "#/$defs/id",
              "x-refers": "status"
            },
            "atLeast": {
              "type": "integer",
              "minimum": 0
            },
            "atMost": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "how many units hold this status from you",
          "oneOf": [
            {
              "required": [
                "atLeast"
              ]
            },
            {
              "required": [
                "atMost"
              ]
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "unitsOut"
          ],
          "additionalProperties": false,
          "properties": {
            "unitsOut": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/id",
                "x-refers": "unit"
              },
              "description": "you have one of these units out"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "inEffectArea"
          ],
          "additionalProperties": false,
          "properties": {
            "inEffectArea": {
              "$ref": "#/$defs/id",
              "description": "the target stands in the effect area this ability of yours put down",
              "x-refers": "ability"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "spentAtLeast"
          ],
          "additionalProperties": false,
          "properties": {
            "spentAtLeast": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "targetsHitAtLeast"
          ],
          "additionalProperties": false,
          "properties": {
            "targetsHitAtLeast": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "outcome"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "enum": [
                "crit",
                "survived"
              ],
              "description": "how the hit just made went"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "targetHealthBelowMine"
          ],
          "additionalProperties": false,
          "properties": {
            "targetHealthBelowMine": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "group"
          ],
          "additionalProperties": false,
          "properties": {
            "group": {
              "type": "string",
              "description": "a status of this group"
            },
            "on": {
              "enum": [
                "self",
                "target"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "wielding"
          ],
          "additionalProperties": false,
          "properties": {
            "wielding": {
              "enum": [
                "shield",
                "oneHanded",
                "twoHanded",
                "dual"
              ],
              "description": "what you have equipped"
            }
          }
        }
      ]
    },
    "creatureType": {
      "enum": [
        "beast",
        "humanoid",
        "undead",
        "elemental",
        "demon",
        "dragonkin",
        "giant",
        "mechanical",
        "aberration",
        "critter"
      ]
    },
    "school": {
      "enum": [
        "physical",
        "holy",
        "fire",
        "nature",
        "frost",
        "shadow",
        "arcane"
      ]
    },
    "schools": {
      "type": "array",
      "minItems": 1,
      "description": "several schools at once, or `all`. A hit in several counts as each of them",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/school"
          },
          {
            "const": "all"
          }
        ]
      }
    },
    "stat": {
      "enum": [
        "strength",
        "agility",
        "intellect",
        "stamina",
        "armor",
        "critRating",
        "hasteRating",
        "masteryRating",
        "versatilityRating",
        "leechRating",
        "avoidanceRating",
        "speedRating"
      ]
    },
    "anyStat": {
      "enum": [
        "strength",
        "agility",
        "intellect",
        "stamina",
        "armor",
        "critRating",
        "hasteRating",
        "masteryRating",
        "versatilityRating",
        "leechRating",
        "avoidanceRating",
        "speedRating",
        "attackPower",
        "spellPower",
        "maxHealth",
        "critChance",
        "critDamage",
        "critHealing",
        "critTaken",
        "haste",
        "mastery",
        "versatility",
        "leech",
        "avoidance",
        "dodge",
        "parry",
        "block",
        "movementSpeed",
        "attackSpeed",
        "stealth",
        "detection",
        "damageDone",
        "healingDone",
        "damageTaken",
        "healingTaken",
        "threat",
        "resourceMax",
        "resourceRegen",
        "resourceRest",
        "resourceDecay",
        "resourceGain"
      ]
    },
    "quality": {
      "enum": [
        "poor",
        "common",
        "uncommon",
        "rare",
        "epic"
      ]
    },
    "slot": {
      "enum": [
        "head",
        "neck",
        "shoulders",
        "back",
        "chest",
        "wrists",
        "hands",
        "waist",
        "legs",
        "feet",
        "finger",
        "trinket",
        "oneHand",
        "mainHand",
        "offHand",
        "twoHand",
        "ranged"
      ]
    },
    "armorType": {
      "enum": [
        "cloth",
        "leather",
        "chain",
        "plate"
      ]
    },
    "region": {
      "type": "array",
      "description": "A multipolygon in tile units: polygons, each a list of rings (outline first, then holes), each ring a list of [x, z] corners, implicitly closed.",
      "items": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "required": [
        "key",
        "name",
        "kind",
        "color"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "mana",
            "energy",
            "rage",
            "points"
          ]
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "description": "points only"
        },
        "regen": {
          "type": "number",
          "minimum": 0,
          "description": "points a second, points only"
        },
        "decay": {
          "type": "number",
          "minimum": 0,
          "description": "points a second out of combat, points only"
        }
      }
    },
    "effect": {
      "type": "object",
      "required": [
        "type",
        "affects"
      ],
      "properties": {
        "type": {
          "enum": [
            "damage",
            "heal",
            "resource",
            "status",
            "interrupt",
            "taunt",
            "move",
            "dispel",
            "resurrect",
            "consume",
            "cooldown",
            "summon",
            "command",
            "effectArea",
            "extend",
            "extraTargets",
            "castAbility",
            "threat",
            "reveal"
          ]
        },
        "affects": {
          "enum": [
            "target",
            "self",
            "enemies",
            "allies",
            "summons",
            "holder",
            "caster",
            "hit"
          ]
        },
        "around": {
          "enum": [
            "self",
            "target",
            "ground",
            "holders",
            "random"
          ]
        },
        "holding": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id",
            "x-refers": "status"
          },
          "description": "with affects enemies or allies: only those holding one of these statuses from you, wherever they are"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cone": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 360
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "prefers": {
          "enum": [
            "injured",
            "nearest",
            "farthest",
            "lowestHealth"
          ],
          "description": "with max: which it picks first, nearest by default"
        },
        "amount": {
          "$ref": "#/$defs/amount"
        },
        "seconds": {
          "type": "number",
          "description": "extend: seconds added. consume: only this much of its time goes"
        },
        "perSpent": {
          "type": "number",
          "description": "extend: seconds added for each point spent"
        },
        "refresh": {
          "type": "boolean",
          "description": "extend: starts its duration over instead"
        },
        "apply": {
          "type": "boolean",
          "description": "extend: applies it if it is not on yet"
        },
        "maxShare": {
          "type": "number",
          "description": "extend: the most it can be extended by, as a share of its full duration"
        },
        "dealsLeft": {
          "type": "number",
          "description": "consume: does this share of what it had left to do now"
        },
        "keeps": {
          "type": "boolean",
          "description": "consume: with dealsLeft, leaves the status on"
        },
        "perStack": {
          "$ref": "#/$defs/effect",
          "description": "consume: this effect happens once for each stack taken"
        },
        "creatureTypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/creatureType"
          },
          "description": "only those of these types"
        },
        "drain": {
          "type": "number",
          "description": "heals the caster by this share of what the effect does"
        },
        "school": {
          "$ref": "#/$defs/school"
        },
        "schools": {
          "$ref": "#/$defs/schools"
        },
        "resource": {
          "type": "string",
          "x-refers": "resource"
        },
        "status": {
          "$ref": "#/$defs/id",
          "x-refers": "status"
        },
        "unit": {
          "$ref": "#/$defs/id",
          "description": "summon: which of the class's units",
          "x-refers": "unit"
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id",
            "x-refers": "unit"
          },
          "description": "with affects summons, consume or command: only these units"
        },
        "source": {
          "enum": [
            "self",
            "summons"
          ],
          "description": "who does it, the caster by default. With summons, they do it"
        },
        "lasts": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "summon: seconds it stays. Left out, it stays until it dies or is dismissed"
        },
        "obeys": {
          "type": "boolean",
          "description": "summon: you command it"
        },
        "ability": {
          "$ref": "#/$defs/id",
          "description": "command: the ability your summons use. castAbility: the ability it casts",
          "x-refers": "ability"
        },
        "free": {
          "type": "boolean",
          "description": "castAbility: it costs nothing"
        },
        "strength": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "castAbility: what it does is multiplied by this"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "description": "castAbility: the empowered level it casts at"
        },
        "clear": {
          "type": "boolean",
          "description": "threat: wipes it, so enemies stop chasing you for it"
        },
        "multiply": {
          "type": "number",
          "description": "threat: multiplies what it is"
        },
        "statuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id",
            "x-refers": "status"
          },
          "description": "summon: statuses it arrives with"
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lockout": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "kind": {
          "enum": [
            "charge",
            "leap",
            "knockback",
            "pull",
            "blink",
            "dash",
            "knockup",
            "leapBack",
            "behind"
          ]
        },
        "to": {
          "enum": [
            "self",
            "target",
            "ground"
          ],
          "description": "move: where it goes, for one that isn't plain"
        },
        "distance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dispels": {
          "type": "array",
          "description": "the kinds of status it removes, or the controls. slow means every status that lowers movement speed",
          "items": {
            "enum": [
              "magic",
              "curse",
              "poison",
              "disease",
              "enrage",
              "stun",
              "root",
              "silence",
              "incapacitate",
              "disorient",
              "fear",
              "disarm",
              "slow"
            ]
          },
          "minItems": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "dispel: how many statuses it removes, 1 by default"
        },
        "health": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "description": "resurrect: the percent of health it comes back with"
        },
        "durationPerSpent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "status: seconds more for each point the ability spends with an `all` cost"
        },
        "stacks": {
          "type": "integer",
          "minimum": 1,
          "description": "consume: how many stacks it takes, all of them by default"
