{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sketch.schema.json",
  "title": "sketch.json",
  "description": "A continent's pins, road paths and water, at places/continents/<c>/sketch.json. Points are in tile units. The editor upgrades older versions when it opens them.",
  "type": "object",
  "required": [
    "version",
    "pins",
    "paths"
  ],
  "properties": {
    "version": {
      "const": 5
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "biome",
              "road",
              "hub",
              "info",
              "source"
            ]
          },
          "at": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "biome": {
            "type": "string",
            "description": "biome pins"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "radius": {
            "type": "number",
            "description": "hub pins, feet"
          },
          "width": {
            "type": "number",
            "description": "source pins, feet"
          }
        }
      }
    },
    "paths": {
      "type": "array",
      "description": "Roads between road pins.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "description": "a road pin's id"
          },
          "to": {
            "type": "string"
          },
          "width": {
            "type": "number",
            "description": "feet"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "route": {
            "type": "object",
            "description": "The worked-out route; key says what it was worked out from.",
            "properties": {
              "key": {
                "type": "string"
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "lengthFt": {
                "type": "number"
              },
              "grade": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "water": {
      "type": "object",
      "properties": {
        "rivers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "points",
              "width"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "description": "from source to mouth"
              },
              "width": {
                "type": "number",
                "description": "feet"
              }
            }
          }
        },
        "lakes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "seed",
              "level"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "seed": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "level": {
                "type": "number",
                "description": "water level, feet"
              }
            },
            "description": "A lake's shape isn't kept: it's the ground below its level that joins up with its seed."
          }
        }
      }
    }
  }
}
