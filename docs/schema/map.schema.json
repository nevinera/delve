{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map.schema.json",
  "title": "places/continents/<c>/map.json",
  "description": "A continent's map pins: places marked on the map in play, set with /create's map tool.",
  "type": "object",
  "required": [
    "version",
    "pins"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
            "description": "The pin's own id, unique on its continent, for other files to point at."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "What the map shows as the pointer's over it."
          },
          "type": {
            "enum": [
              "place",
              "cave"
            ],
            "description": "Which icon it has: a pin, or a cave's mouth."
          },
          "at": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "[x, z] in continent feet."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
