#!/usr/bin/env node
// Prints, sets or removes one annotation (see docs/schema/common.md#annotations)
// on a world, zone, map, place, unit type, unit, quest or NCU in the content
// files: how an LLM writes its notes between the steps of building a world.
// Run with --help for the flags.
import {parseArgs} from "node:util";
import {readFileSync, writeFileSync} from "node:fs";
import {resolve} from "node:path";
import {client} from "../client/cli/load.mjs";

const {findTarget, annotationsOf, setAnnotation, removeAnnotation, setPlaceName, formatLike} = await client("annotations/annotate.js");

const USAGE = `Usage: bin/annotate [flags] FILE TARGET [TEXT]

  FILE            a world or zone file; $refs (maps, unit types, the quests file, a
                  world's zones) are followed to the file that holds the target
  TARGET          from a zone file: zone, unit-type:<key>, <map>, <map>/<place>,
                  <map>/unit:<id>, <map>/ncu:<id>
                  from a world file: world, quest:<id>, zone:<key>[/<zone target>]
  --set KEY       set annotation KEY to TEXT (or - for stdin)
  --remove KEY    remove annotation KEY
  --name TEXT     name a place (its display name, not an annotation); with --set,
                  both
  --json          print the annotations as JSON, not text
  -h, --help

With none of --set, --remove and --name, prints the target's annotations. Writes the
source files (2-space JSON, as the editors do); a zone's .full.json picks the
change up at its next Expand.

  bin/annotate zones/gnawdeep/gnawdeep.json grutts-hall/throne --set population "dense; goblin 4; group"
  bin/annotate worlds/demo-wild/demo-wild.json quest:l3-grutt --set plan - < plan.txt
  bin/annotate zones/gnawdeep/gnawdeep.json grutts-hall/area_3 --name "Grutt's Throne" --set intent "Grutt's seat."
  bin/annotate zones/gnawdeep/gnawdeep.json grutts-hall/unit:grutt`;

const {values, positionals} = parseArgs({allowPositionals: true, options: {
  set: {type: "string"},
  remove: {type: "string"},
  name: {type: "string"},
  json: {type: "boolean", default: false},
  help: {type: "boolean", short: "h", default: false},
}});
const want = values.set !== undefined ? 3 : 2;
if (values.help || positionals.length !== want || (values.set !== undefined && values.remove !== undefined)) {
  console.log(USAGE);
  process.exit(values.help ? 0 : 1);
}

const fail = (message) => {
  console.error(`bin/annotate: ${message}`);
  process.exit(1);
};

const texts = new Map();
const read = (path) => {
  try {
    const text = readFileSync(path, "utf8");
    texts.set(path, text);
    return JSON.parse(text);
  } catch (error) {
    fail(`${path}: ${error.code === "ENOENT" ? "no such file" : error.message}`);
  }
};

const [file, target, text] = positionals;
let found;
try {
  found = findTarget(read, resolve(file), target);
} catch (error) {
  fail(error.message);
}

const save = () => writeFileSync(found.file, formatLike(texts.get(found.file), found.data));

if (values.name !== undefined) {
  if (!found.places) fail(`${found.label}: --name is for places`);
  try {
    setPlaceName(found.places, found.object, values.name);
  } catch (error) {
    fail(`${found.label}: ${error.message}`);
  }
  if (values.set === undefined) save();
}
if (values.set !== undefined) {
  try {
    setAnnotation(found.object, values.set, text === "-" ? readFileSync(0, "utf8").trimEnd() : text);
  } catch (error) {
    fail(`${found.label}: ${error.message}`);
  }
  save();
} else if (values.name !== undefined) {
  // Named above.
} else if (values.remove !== undefined) {
  if (!removeAnnotation(found.object, values.remove)) fail(`${found.label} has no annotation ${JSON.stringify(values.remove)}`);
  save();
} else {
  const annotations = annotationsOf(found.object);
  if (values.json) process.stdout.write(JSON.stringify(annotations, null, 2) + "\n");
  else for (const [key, value] of Object.entries(annotations)) process.stdout.write(`${key}: ${value}\n`);
}
