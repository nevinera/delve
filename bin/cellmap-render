#!/usr/bin/env node
// Renders a cell map to a PNG, as the game draws it (see
// client/src/cellMap/render.js), with optional overlays. Takes a cellMap's
// JSON or a whole map file's (one with a cellMap). Run with --help.
import {parseArgs} from "node:util";
import {readFileSync, writeFileSync} from "node:fs";
import {createCanvas} from "@napi-rs/canvas";
import {client} from "../client/cli/load.mjs";

const {renderCellMap} = await client("cellMap/render.js");
const {validateCellMap, THEMES} = await client("cellMap/format.js");
const {drawCells, drawExits, drawTrails, drawBridges} = await client("cellMap/overlay.js");
const {mapSize} = await client("cellMap/hexGrid.js");

const USAGE = `Usage: bin/cellmap-render FILE [flags]

  FILE            a cellMap, or a map file with one; - reads stdin
  -o, --out FILE  the PNG to write (default: FILE with .png, or map.png from stdin)
  --scale N       pixels per foot (default 6; cells are 5 ft)
  --theme NAME    draw it in another theme: ${Object.keys(THEMES).join(", ")}
  --seed N        another decoration seed
  --cells         tint each cell by its terrain, with hex outlines
  --grid          hex outlines only
  --trails        trails and bridges as drawn in the editor
  --exits         the cellMap's exits along the edge
  --barriers      the map's barriers, connections and fill (a map file's; or, with
                  --auto, made by Auto Barriers)
  --auto          make the barriers with Auto Barriers instead of the file's
  --places        the map's places, outlined and labeled (a map file's; or Auto Barriers')
  --units         a map file's units (red hostile, yellow neutral, green friendly) with
                  their wander circles and patrols, and its NCUs (blue)
  -h, --help`;

const {values, positionals} = parseArgs({allowPositionals: true, options: {
  out: {type: "string", short: "o"},
  scale: {type: "string", default: "6"},
  theme: {type: "string"},
  seed: {type: "string"},
  cells: {type: "boolean", default: false},
  grid: {type: "boolean", default: false},
  trails: {type: "boolean", default: false},
  exits: {type: "boolean", default: false},
  barriers: {type: "boolean", default: false},
  auto: {type: "boolean", default: false},
  places: {type: "boolean", default: false},
  units: {type: "boolean", default: false},
  help: {type: "boolean", short: "h", default: false},
}});
if (values.help) {
  console.log(USAGE);
  process.exit(0);
}
function fail(message) {
  console.error(`${message}\n\n${USAGE}`);
  process.exit(1);
}
const [file] = positionals;
if (!file) fail("Which file?");

const data = JSON.parse(file === "-" ? readFileSync(0, "utf8") : readFileSync(file, "utf8"));
let cellMap = data.cellMap ?? data;
if (values.theme) cellMap = {...cellMap, theme: values.theme};
if (values.seed !== undefined) cellMap = {...cellMap, seed: Number(values.seed)};
const errors = validateCellMap(cellMap);
if (errors.length) fail(`Not a valid cellMap:\n  ${errors.join("\n  ")}`);

const scale = Number(values.scale);
if (!(scale > 0)) fail("--scale must be a positive number");
const {canvas} = renderCellMap(cellMap, {pixelsPerFoot: scale, createCanvas});
const ctx = canvas.getContext("2d");
ctx.setTransform(scale, 0, 0, scale, 0, 0);
if (values.cells || values.grid) drawCells(ctx, cellMap, scale, {filled: values.cells});
if (values.trails) {
  drawTrails(ctx, cellMap, scale);
  drawBridges(ctx, cellMap, scale);
}
if (values.exits) drawExits(ctx, cellMap, scale);
if (values.barriers || values.auto) await drawBarriers(ctx, data, cellMap, scale);
if (values.places) await drawPlaces(ctx, data, cellMap, scale);
if (values.units) drawUnits(ctx, data, cellMap, scale);

const out = values.out ?? (file === "-" ? "map.png" : file.replace(/\.json$/, "") + ".png");
writeFileSync(out, canvas.toBuffer("image/png"));
console.error(`Wrote ${out} (${canvas.width}x${canvas.height})`);

// Barriers in map feet (y up): the fill shaded, walls (blue where you can
// see across them), circles, and line connections in green.
async function drawBarriers(ctx, data, cellMap, scale) {
  const {computeMapFill} = await client("game/mapFill.js");
  let {barriers = [], connections = [], fillPoints = []} = data.cellMap ? data : {};
  if (values.auto) {
    const {autoBarriers} = await client("mapEditor/cells/autoBarriers.js");
    const result = autoBarriers(cellMap);
    if (result.error) fail(result.error);
    const named = new Set(result.connections.map((c) => c.identifier));
    ({barriers, fillPoints} = result);
    connections = [...connections.filter((c) => !named.has(c.identifier)), ...result.connections];
  }
  const feetDimensions = mapSize(cellMap.grid);
  const y = (v) => feetDimensions.height - v;
  const fill = computeMapFill({feetDimensions, barriers, connections, fillPoints});
  ctx.fillStyle = "rgba(200, 30, 60, 0.3)";
  ctx.beginPath();
  for (const {outer, holes} of fill.filled) {
    for (const ring of [outer, ...holes]) {
      ring.forEach(([px, py], i) => (i ? ctx.lineTo(px, y(py)) : ctx.moveTo(px, y(py))));
      ctx.closePath();
    }
  }
  ctx.fill("evenodd");
  ctx.lineWidth = 3 / scale;
  for (const barrier of barriers) {
    ctx.strokeStyle = barrier.blocksSight === false ? "rgba(60, 170, 230, 0.95)" : "rgba(230, 40, 40, 0.95)";
    ctx.beginPath();
    if (barrier.type === "circle") ctx.arc(barrier.location.x, y(barrier.location.y), barrier.radius, 0, Math.PI * 2);
    else barrier.locations.forEach((p, i) => (i ? ctx.lineTo(p.x, y(p.y)) : ctx.moveTo(p.x, y(p.y))));
    ctx.stroke();
  }
  ctx.strokeStyle = "rgba(40, 220, 90, 0.95)";
  ctx.lineWidth = 6 / scale;
  for (const c of connections.filter((c) => c.type === "line")) {
    ctx.beginPath();
    ctx.moveTo(c.start.x, y(c.start.y));
    ctx.lineTo(c.end.x, y(c.end.y));
    ctx.stroke();
  }
  ctx.fillStyle = "rgba(255, 255, 255, 0.9)";
  for (const p of fillPoints) {
    ctx.beginPath();
    ctx.arc(p.x, y(p.y), 6 / scale, 0, Math.PI * 2);
    ctx.fill();
  }
}

// Places in map feet (y up), each outlined, with its identifier (less
// "area_") at its outline's middle.
async function drawPlaces(ctx, data, cellMap, scale) {
  let places = data.cellMap ? data.places ?? [] : [];
  if (!places.length) {
    const {autoBarriers} = await client("mapEditor/cells/autoBarriers.js");
    places = autoBarriers(cellMap).places ?? [];
  }
  const {height} = mapSize(cellMap.grid);
  ctx.lineWidth = 2 / scale;
  ctx.strokeStyle = "rgba(255, 255, 255, 0.8)";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.font = `bold ${16 / scale}px sans-serif`;
  for (const {identifier, polygon} of places) {
    ctx.beginPath();
    polygon.forEach(({x, y}, i) => (i ? ctx.lineTo(x, height - y) : ctx.moveTo(x, height - y)));
    ctx.closePath();
    ctx.stroke();
  }
  for (const {identifier, polygon} of places) {
    const x = polygon.reduce((sum, p) => sum + p.x, 0) / polygon.length;
    const y = height - polygon.reduce((sum, p) => sum + p.y, 0) / polygon.length;
    const text = identifier.replace(/^area_/, "");
    ctx.fillStyle = "rgba(0, 0, 0, 0.75)";
    const w = ctx.measureText(text).width + 8 / scale;
    ctx.fillRect(x - w / 2, y - 10 / scale, w, 20 / scale);
    ctx.fillStyle = "#fff";
    ctx.fillText(text, x, y);
  }
}

// A map file's units and NCUs, in map feet (y up): a dot each, a faint
// circle for a wanderer's range, a line for a patrol.
function drawUnits(ctx, data, cellMap, scale) {
  const {height} = mapSize(cellMap.grid);
  const COLORS = {hostile: "#e03030", neutral: "#e8c020", friendly: "#30c040"};
  ctx.lineWidth = 1.5 / scale;
  for (const {position, hostility, movement} of data.units ?? []) {
    if (!position) continue;
    if (movement?.type === "wander" && movement.location) {
      ctx.strokeStyle = "rgba(255, 255, 255, 0.35)";
      ctx.beginPath();
      ctx.arc(movement.location.x, height - movement.location.y, movement.radius, 0, 2 * Math.PI);
      ctx.stroke();
    } else if (movement?.type === "patrol") {
      ctx.strokeStyle = "rgba(255, 255, 255, 0.6)";
      ctx.beginPath();
      movement.steps.forEach(({position: p}, i) => (i ? ctx.lineTo(p.x, height - p.y) : ctx.moveTo(p.x, height - p.y)));
      ctx.stroke();
    }
    dot(ctx, position.x, height - position.y, 2, COLORS[hostility] ?? "#fff", scale);
  }
  for (const {position} of data.ncus ?? []) if (position) dot(ctx, position.x, height - position.y, 3, "#30a0ff", scale);
}

function dot(ctx, x, y, radius, color, scale) {
  ctx.fillStyle = color;
  ctx.strokeStyle = "#000";
  ctx.lineWidth = 2 / scale;
  ctx.beginPath();
  ctx.arc(x, y, radius, 0, 2 * Math.PI);
  ctx.fill();
  ctx.stroke();
}
