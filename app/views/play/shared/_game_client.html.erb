<div id="app"
  data-slot-token="<%= result.token %>"
  data-game-server-url="<%= game_server_public_url %>"
  data-instance-id="<%= result.instance_identifier %>"
  data-slot-id="<%= result.slot_id %>"
  data-zone-source-url="<%= zone_source_url %>"
  data-zone-source-sha="<%= zone_source_sha %>"
  data-character-name="<%= character.name %>"
  data-character-token-url="<%= character.token_image_url %>"
  data-class-config-url="<%= character.character_class.location %>"
  data-class-config-sha="<%= character.character_class.content_sha %>"
  data-owned-zone-items="<%= owned_zone_items.to_json %>"
  data-equipped-items="<%= equipped_items.to_json %>"
  <% if local_assigns[:character_items_url] %>data-character-items-url="<%= character_items_url %>"<% end %>
  <% if local_assigns[:equipped_items_url] %>data-equipped-items-url="<%= equipped_items_url %>"<% end %>
  <% if local_assigns[:held_flags] %>data-held-flags="<%= held_flags.to_json %>"<% end %>
  <% if local_assigns[:flags_url] %>data-flags-url="<%= flags_url %>"<% end %>
  <% if local_assigns[:zone_identifier] %>data-zone-identifier="<%= zone_identifier %>"<% end %>
  <% if local_assigns[:active_quests_url] %>data-active-quests-url="<%= active_quests_url %>"<% end %>
  <% if local_assigns[:quests_url] %>data-quests-url="<%= quests_url %>" data-quests-sha="<%= quests_sha %>"<% end %>
  <% if local_assigns[:provenance_restrictions] %>data-provenance-restrictions="<%= provenance_restrictions.to_json %>"<% end %>
  data-character-settings="<%= character_settings.to_json %>"
  data-character-settings-url="<%= play_character_setting_path(character) %>"
  data-stock-assets="<%= stock_assets.to_json %>"
  <% if local_assigns[:world_return_url] %>data-world-return-url="<%= world_return_url %>"<% end %>
  <% if local_assigns[:leave_world_url] %>data-leave-world-url="<%= leave_world_url %>"<% end %>
></div>
