<h1><%= @item.name %></h1>

<p>Slot: <%= @item.slot %></p>
<p>Elevation: <%= @item.elvl %></p>
<p>From: <%= @item.provenance_zone&.identifier %></p>
<p>Received: <%= @item.received_at.strftime("%Y-%m-%d %H:%M") %></p>

<% if @raw_stats.any? %>
  <p>Stats at ee=0 (on-level):</p>
  <ul>
    <% @raw_stats.sort.each do |stat, value| %>
      <li><%= stat.to_s.humanize %>: <%= value.round(1) %></li>
    <% end %>
  </ul>
<% end %>

<% if @item.description.present? %>
  <p><em><%= @item.description %></em></p>
<% end %>

<% if @item.equipped_item %>
  <p>
    <%= button_to "Unequip from #{EquippedItem::SLOT_LABELS[@item.equipped_item.equipped_slot]}",
      play_character_equipped_item_path(@character, @item.equipped_item.equipped_slot),
      method: :patch,
      params: {character_item_id: ""} %>
  </p>
<% else %>
  <% equippable_slots = EquippedItem::SLOT_COMPATIBILITY[@item.slot] || [] %>
  <% if equippable_slots.any? %>
    <p>
      <% equippable_slots.each do |slot| %>
        <%= button_to "Equip as #{EquippedItem::SLOT_LABELS[slot]}",
          play_character_equipped_item_path(@character, slot),
          method: :patch,
          params: {character_item_id: @item.id} %>
      <% end %>
    </p>
  <% end %>
<% end %>

<%= link_to "Back to items", play_character_character_items_path(@character) %>
