<h1><%= @character.name %> - Items</h1>

<% if @filter_slots.present? %>
  <p>
    Filtered to slot<%= "s" if @filter_slots.size > 1 %>: <%= @filter_slots.join(", ") %>
    (<%= link_to "clear filter", play_character_world_character_items_path(@character, @world) %>)
  </p>
<% end %>

<% if @items.empty? %>
  <p>No items<%= " matching this filter" if @filter_slots.present? %>.</p>
<% else %>
  <ul class="entry-list">
    <% @items.each do |item| %>
      <li>
        <span class="entry-title"><%= item.name %></span>
        <span class="entry-state"><%= item.slot %></span>
        <div class="entry-meta">
          <span>elvl <%= item.elvl %></span>
          <span><%= item.provenance_label %></span>
          <span>received <%= item.created_at.strftime("%Y-%m-%d") %></span>
        </div>
        <%= link_to "View", play_character_world_character_item_path(@character, @world, item) %>
      </li>
    <% end %>
  </ul>
<% end %>

<%= link_to "Back to #{@world.name || @world.key}", play_character_world_path(@character, @world) %>
