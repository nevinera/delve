<h1><%= @character.name %> - Items</h1>

<% if @filter_slots.present? %>
  <p>
    Filtered to slot<%= "s" if @filter_slots.size > 1 %>: <%= @filter_slots.join(", ") %>
    (<%= link_to "clear filter", play_character_character_items_path(@character) %>)
  </p>
<% end %>

<% if @items.empty? %>
  <p>No items<%= " matching this filter" if @filter_slots.present? %>.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Slot</th>
        <th>elvl</th>
        <th>From</th>
        <th>Received</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @items.each do |item| %>
        <tr>
          <td><%= item.name %></td>
          <td><%= item.slot %></td>
          <td><%= item.elvl %></td>
          <td><%= item.provenance_zone.identifier %></td>
          <td><%= item.received_at.strftime("%Y-%m-%d") %></td>
          <td><%= link_to "View", play_character_character_item_path(@character, item) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<%= link_to "Back to #{@character.name}", play_character_path(@character) %>
