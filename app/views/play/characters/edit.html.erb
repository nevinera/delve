<h1><%= @character.name %></h1>

<%= form_with model: @character, url: play_character_path(@character), method: :patch do |f| %>
  <% if @character.errors.any? %>
    <ul>
      <% @character.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  <% end %>

  <%= render "token_fields", f:, character: @character %>

  <div>
    <%= f.label :character_class_id, "Class" %>
    <% if @character.in_zone? %>
      <%= "#{@character.character_class.identifier} #{@character.character_class.version}" %>
      <p><small>Leave the world to change class.</small></p>
    <% else %>
      <%= f.select :character_class_id, @character_classes.map { |cc| ["#{cc.identifier} #{cc.version}", cc.id] } %>
    <% end %>
  </div>

  <%= f.submit "Save" %>
<% end %>

<%= link_to "Cancel", play_character_path(@character) %>
