<section>
  <h2><%= character_class.name.presence || character_class.identifier %></h2>
  <%= render "shared/refetch_class_button", character_class: %>
  <% if character_class.description.present? %>
    <p><%= character_class.description %></p>
  <% end %>

  <h3>Abilities</h3>
  <% if character_class.class_abilities.any? %>
    <ul class="ability-list">
      <% character_class.class_abilities.each do |ability| %>
        <li class="ability-row">
          <% if ability.icon_mask_url && ability.icon_color %>
            <span role="img" aria-label="<%= ability.name %>" class="ability-icon ability-icon-framed ability-icon-masked">
              <span style="background-color: <%= ability.icon_color %>; -webkit-mask: url('<%= ability.icon_mask_url %>') center / contain no-repeat; mask: url('<%= ability.icon_mask_url %>') center / contain no-repeat;"></span>
            </span>
          <% elsif ability.icon_url.present? %>
            <%= image_tag ability.icon_url, alt: ability.name, class: "ability-icon ability-icon-framed" %>
          <% else %>
            <span class="ability-icon"></span>
          <% end %>
          <div>
            <strong><%= ability.name %></strong>
            <div><small><%= ability.stat_summary %></small></div>
            <% if ability.description.present? %>
              <div><%= ability.description %></div>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p><em>No abilities.</em></p>
  <% end %>
</section>
