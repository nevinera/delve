<h1>Characters</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Class</th>
      <th>Last Played</th>
      <th>Latest World</th>
    </tr>
  </thead>
  <tbody>
    <% @characters.each do |character| %>
      <% last = character.last_world_character %>
      <tr>
        <td><%= link_to character.name, play_character_path(character) %></td>
        <td><%= "#{character.character_class.identifier} #{character.character_class.version}" %></td>
        <td><%= last&.last_played_at&.strftime("%Y-%m-%d") || "Never" %></td>
        <td>
          <% if last %>
            <%= link_to last.world.name || last.world.key, play_character_world_path(character, last.world) %>
            <% if (latest = last.world.released_versions.first) %>
              <% if last.world_version.nil? || last.world_version == latest %>
                <%= button_to "Enter", play_play_character_world_path(character, last.world), method: :get, class: "compact", form_class: "inline" %>
              <% else %>
                <%= button_to "Upgrade from #{last.world_version.ref.split("/").last}->#{latest.ref.split("/").last}",
                      version_play_character_world_path(character, last.world), method: :patch,
                      params: {world_version_id: latest.id}, class: "compact upgrade", form_class: "inline" %>
              <% end %>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "New character", new_play_character_path %>
