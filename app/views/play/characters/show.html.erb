<h1><%= @character.name %></h1>

<%= image_tag @character.token_url, style: "width: 64px; height: 64px; object-fit: cover;" %>
<p>Class: <%= "#{@character.character_class.identifier} #{@character.character_class.version}" %></p>
<p>Last played: <%= @character.last_played_at&.strftime("%Y-%m-%d %H:%M") || "Never" %></p>

<%= render "class_details", character_class: @character.character_class %>

<%= link_to "Worlds", play_character_worlds_path(@character) %>
<%= link_to "Edit token", edit_play_character_path(@character) %>
<%= link_to "All characters", play_characters_path %>
