<h1><%= @character.name %> - Equipped Items</h1>

<ul class="entry-list">
  <% EquippedItem::EQUIPPED_SLOTS.each do |slot| %>
    <% equipped_item = @equipped_items_by_slot[slot] %>
    <li>
      <span class="entry-title"><%= EquippedItem::SLOT_LABELS[slot] %></span>
      <% if equipped_item %>
        <div class="entry-meta">
          <span><%= equipped_item.character_item.name %></span>
          <span>elvl <%= equipped_item.character_item.elvl %></span>
          <span><%= equipped_item.character_item.provenance_label %></span>
        </div>
      <% else %>
        <div class="entry-meta"><em>Empty</em></div>
      <% end %>
      <span class="entry-actions">
        <% if equipped_item %>
          <%= link_to "View item", play_character_world_character_item_path(@character, @world, equipped_item.character_item) %>
        <% end %>
        <%= link_to "Equippable", play_character_world_character_items_path(@character, @world, slot: EquippedItem.item_slots_for(slot)) %>
      </span>
    </li>
  <% end %>
</ul>

<%= link_to "Back to #{@world.name || @world.key}", play_character_world_path(@character, @world) %>
