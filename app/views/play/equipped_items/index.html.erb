<h1><%= @character.name %> - Equipped Items</h1>

<table>
  <thead>
    <tr>
      <th>Slot</th>
      <th>Item</th>
      <th>ilvl</th>
      <th>From</th>
      <th></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% EquippedItem::EQUIPPED_SLOTS.each do |slot| %>
      <% equipped_item = @equipped_items_by_slot[slot] %>
      <tr>
        <td><%= EquippedItem::SLOT_LABELS[slot] %></td>
        <% if equipped_item %>
          <td><%= equipped_item.character_item.name %></td>
          <td><%= equipped_item.character_item.ilvl %></td>
          <td><%= equipped_item.character_item.provenance_zone.identifier %></td>
          <td><%= link_to "View item", play_character_character_item_path(@character, equipped_item.character_item) %></td>
        <% else %>
          <td colspan="3"><em>Empty</em></td>
          <td></td>
        <% end %>
        <td><%= link_to "Equippable", play_character_character_items_path(@character, slot: EquippedItem.item_slots_for(slot)) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "Back to #{@character.name}", play_character_path(@character) %>
