<h1>Worlds</h1>

<p>
  Pick a world to enter with <%= @character.name %>.
  <% if @show_all %>
    <%= link_to "Hide the worlds you've hidden", play_character_worlds_path(@character) %>
  <% else %>
    <%= link_to "Show all worlds", play_character_worlds_path(@character, all: 1) %>
  <% end %>
</p>

<table>
  <tbody>
    <% @rows.each do |row| %>
      <% world, world_character, current, latest = row.values_at(:world, :world_character, :current, :latest) %>
      <tr>
        <td><%= link_to row[:name], play_character_world_path(@character, world) %></td>
        <td>
          <% if current %>
            <%= current.ref %><%= " (expired)" if current.expired? %>
          <% elsif latest %>
            <%= latest.ref %>
          <% end %>
        </td>
        <td>
          <% if row[:upgradable] %>
            <%= button_to "Upgrade to #{latest.ref}", version_play_character_world_path(@character, world),
                  method: :patch, params: {world_version_id: latest.id}, class: "compact",
                  disabled: @in_world_id == world.id,
                  title: (@in_world_id == world.id ? "Leave the world to upgrade" : nil) %>
          <% end %>
        </td>
        <td><%= link_to "Enter", play_play_character_world_path(@character, world) if latest %></td>
        <td>
          <% if world_character.nil? || world_character.active? %>
            <%= button_to "Hide", active_play_character_world_path(@character, world), method: :patch, params: {active: false}, class: "compact secondary outline" %>
          <% else %>
            <%= button_to "Show", active_play_character_world_path(@character, world), method: :patch, params: {active: true}, class: "compact secondary outline" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "Back to #{@character.name}", play_character_path(@character) %>
