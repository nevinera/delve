<%= render "play/shared/game_client",
      result: @entry.join, zone_source_url: @zone.world_version.zone_url(@zone), zone_source_sha: @zone.content_sha,
      character: @character,
      owned_zone_items: @entry.owned_zone_items, equipped_items: @equipped_items,
      held_flags: @entry.held_flags, flags_url: "#{play_character_world_path(@character, @world)}/flags",
      provenance_restrictions: @entry.provenance_restrictions,
      character_settings: @character_settings, stock_assets: @stock_assets,
      world_return_url: play_play_character_world_path(@character, @world),
      leave_world_url: leave_play_character_world_path(@character, @world),
      character_items_url: play_character_world_character_items_path(@character, @world, format: :json),
      equipped_items_url: play_character_world_equipped_items_path(@character, @world) %>
