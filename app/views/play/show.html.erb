<canvas id="scene" class="play-scene"></canvas>
<div id="playLoading" class="play-loading"></div>
<p id="playFps" class="play-fps"></p>
<p id="playStatus" class="play-status"></p>
<div id="playCombat" class="play-combat"></div>
<div id="playClasses" class="play-classes" hidden></div>
<div id="playBuild" class="play-classes play-build" hidden></div>
<div id="playAbilities" class="play-classes play-build play-abilities" hidden></div>
<div id="playPaused" class="play-paused" hidden>
  <p>Paused.</p>
  <button id="playResume" type="button">resume</button>
</div>
<div class="play-bar">
  <button type="button" class="play-chat">chat</button>
  <button type="button" data-abilities>abilities</button>
  <button type="button" class="play-menu-button" popovertarget="playMenu">menu</button>
</div>
<div id="playMenu" class="play-menu" popover>
  <div class="play-menu-main">
    <p class="play-menu-title"><strong><%= @character.name %></strong> in <%= @world.display_name %><% if @preview %>, previewing <%= @preview.tag %><% end %></p>
    <button type="button" data-build>specialization and talents</button>
    <button type="button" data-open="playGraphics">graphics settings</button>
    <button type="button" data-open="playKeys">key settings</button>
    <button type="button" class="play-menu-leave" data-log-off>log off</button>
    <a href="/icons/credits.txt" target="_blank" rel="noopener">icon credits</a>
  </div>
  <div id="playGraphics" class="play-menu-page" hidden>
    <button type="button" data-back>back</button>
    <div class="play-graphics"></div>
  </div>
  <div id="playKeys" class="play-menu-page" hidden>
    <button type="button" data-back>back</button>
    <div class="play-keys"></div>
  </div>
</div>
<div id="playLeaving" class="play-leaving" hidden>
  <p>Logging off in <span data-left>20</span> s. Move or act to stay.</p>
  <%= link_to "exit now", worlds_path, data: {exit: true} %>
  <p class="play-leaving-note">Exiting now leaves your character standing here for 20 seconds.</p>
</div>
<div class="play-turn">
  <p>Turn your phone sideways to play.</p>
  <button type="button" id="playSideways" hidden>play sideways</button>
</div>
<script type="application/json" id="playConfig"><%= raw json_escape(@config.to_json) %></script>
