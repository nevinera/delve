<canvas id="scene" class="play-scene"></canvas>
<p id="playStatus" class="play-status"></p>
<div id="playCombat" class="play-combat"></div>
<div id="playPaused" class="play-paused" hidden>
  <p>Paused.</p>
  <button id="playResume" type="button">resume</button>
</div>
<div class="play-bar">
  <button type="button" class="play-chat">chat</button>
  <button type="button" class="play-menu-button" popovertarget="playMenu">menu</button>
</div>
<div id="playMenu" class="play-menu" popover>
  <div class="play-menu-main">
    <p class="play-menu-title"><strong><%= @character.name %></strong> in <%= @world.display_name %><% if @preview %>, previewing <%= @preview.tag %><% end %></p>
    <button type="button" data-open="playGraphics">graphics settings</button>
    <%= link_to "leave world", worlds_path, class: "play-menu-leave" %>
  </div>
  <div id="playGraphics" class="play-menu-page" hidden>
    <button type="button" data-back>back</button>
    <div class="play-graphics"></div>
  </div>
</div>
<div class="play-turn">Turn your phone sideways to play.</div>
<script type="application/json" id="playConfig"><%= raw json_escape(@config.to_json) %></script>
