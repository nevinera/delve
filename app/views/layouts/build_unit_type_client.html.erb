<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Delve - Unit Type Editor</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
<%= render "layouts/content_editor_styles" %>

      .damage-estimate { margin-bottom: 14px; }
      .damage-estimate-header { display: flex; align-items: center; gap: 10px; }
      .damage-estimate .estimate-damage-button { background: #234; border: 1px solid #457; color: #9cf; font-size: 13px; font-weight: 600; padding: 6px 16px; border-radius: 3px; cursor: pointer; }
      .damage-estimate .estimate-damage-button:hover:not(:disabled) { background: #345; }
      .damage-estimate .estimate-damage-button:disabled { background: #333; border-color: #555; color: #888; cursor: default; }
      .damage-estimate-error { font-size: 12px; color: #e79; }
      .content-editor-fields .damage-estimate-table { margin-top: 10px; margin-bottom: 0; font-size: 12px; }
      .content-editor-fields .damage-estimate-table th, .content-editor-fields .damage-estimate-table td { padding: 4px 8px 4px 0; }
      .damage-estimate-ttd { font-size: 11px; color: #9ab; }

    </style>
  </head>
  <body>
    <%= yield %>
    <%= vite_script_tags("src/unitTypeEditor/main.jsx", "/client/unitTypeEditor.js") %>
  </body>
</html>
