<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Delve - Unit Type Editor</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body, #editor-root { width: 100%; height: 100%; }
      body { background: #14181c; color: #ddd; font-family: system-ui, sans-serif; overflow: hidden; }

      .unit-type-editor { display: flex; height: 100%; }
      .unit-type-editor-preview { flex: 2; min-width: 0; display: flex; flex-direction: column; }
      .unit-type-editor-fields { flex: 1; min-width: 0; overflow-y: auto; padding: 14px; background: #1c2126; border-left: 1px solid #333; }

      .unit-type-preview-canvas-area { flex: 1; min-height: 0; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }

      @media (max-width: 700px) {
        .unit-type-editor { flex-direction: column; }
        .unit-type-editor-preview { flex: none; height: 38vh; }
        .unit-type-editor-fields { flex: 1; width: 100%; border-left: none; border-top: 1px solid #333; }
      }

      .unit-type-editor-fields table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
      .unit-type-editor-fields th { text-align: left; padding: 4px 8px 4px 0; color: #9ab; font-weight: normal; white-space: nowrap; vertical-align: top; }
      .unit-type-editor-fields td { padding: 4px 0; word-break: break-word; }
      .unit-type-editor-fields input[type=number] { width: 100px; background: #111; border: 1px solid #555; color: #eee; padding: 3px 6px; border-radius: 3px; }
      .unit-type-editor-fields input[type=text] { width: 100%; background: #111; border: 1px solid #555; color: #eee; padding: 3px 6px; border-radius: 3px; }
      .unit-type-editor-fields select { width: 100%; background: #111; border: 1px solid #555; color: #eee; padding: 3px 6px; border-radius: 3px; }
      .save-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
      .save-bar .validate-button { background: #245; border: 1px solid #47a; color: #dee; font-size: 13px; font-weight: 600; padding: 6px 16px; border-radius: 3px; cursor: pointer; }
      .save-bar .validate-button:hover:not(:disabled) { background: #356; }
      .save-bar .validate-button:disabled { background: #333; border-color: #555; color: #888; cursor: default; }
      .save-bar .save-button { background: #2a4; border: 1px solid #4c7; color: #efe; font-size: 13px; font-weight: 600; padding: 6px 16px; border-radius: 3px; cursor: pointer; }
      .save-bar .save-button:hover:not(:disabled) { background: #3b5; }
      .save-bar .save-button:disabled { background: #333; border-color: #555; color: #888; cursor: default; }
      .save-bar .save-message { font-size: 12px; }
      .save-bar .save-success { color: #7c7; }
      .save-bar .save-error { color: #e79; }

      .damage-estimate { margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid #333; }
      .damage-estimate-header { display: flex; align-items: center; gap: 10px; }
      .damage-estimate .estimate-damage-button { background: #234; border: 1px solid #457; color: #9cf; font-size: 13px; font-weight: 600; padding: 6px 16px; border-radius: 3px; cursor: pointer; }
      .damage-estimate .estimate-damage-button:hover:not(:disabled) { background: #345; }
      .damage-estimate .estimate-damage-button:disabled { background: #333; border-color: #555; color: #888; cursor: default; }
      .damage-estimate-error { font-size: 12px; color: #e79; }
      .unit-type-editor-fields .damage-estimate-table { margin-top: 10px; margin-bottom: 0; font-size: 12px; }
      .unit-type-editor-fields .damage-estimate-table th, .unit-type-editor-fields .damage-estimate-table td { padding: 4px 8px 4px 0; }
      .damage-estimate-ttd { font-size: 11px; color: #9ab; }

      .unit-type-editor-fields .add-buttons-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid #333; }
      .unit-type-editor-fields button.add-entry { background: #234; border: 1px solid #457; color: #9cf; font-size: 12px; padding: 5px 10px; border-radius: 3px; cursor: pointer; }
      .unit-type-editor-fields button.add-entry:hover { background: #345; }
      .unit-type-editor-fields .entry-block { margin: 16px 0; padding-top: 12px; border-top: 1px solid #2a2f35; border-radius: 4px; }
      .unit-type-editor-fields .entry-heading-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
      .unit-type-editor-fields .entry-heading-row h3 { font-size: 13px; color: #cce; font-weight: 600; }
      .unit-type-editor-fields button.remove-entry { background: #422; border: 1px solid #644; color: #e9a; font-size: 11px; padding: 3px 8px; border-radius: 3px; cursor: pointer; flex-shrink: 0; }
      .unit-type-editor-fields button.remove-entry:hover { background: #533; }
      .unit-type-editor-fields .checkbox-list { display: flex; flex-wrap: wrap; gap: 10px; }
      .unit-type-editor-fields .checkbox-list label { display: flex; align-items: center; gap: 4px; font-size: 12px; }
      .unit-type-editor-fields .new-ability-link { font-size: 11px; color: #9ab; }
      .unit-type-editor-fields button.refresh-abilities { background: #333; border: 1px solid #555; color: #ccc; font-size: 11px; padding: 3px 8px; border-radius: 3px; cursor: pointer; }
      .unit-type-editor-fields button.refresh-abilities:hover { background: #444; }

      .power-slots { display: flex; flex-wrap: wrap; gap: 10px; background: #1c2126; border-top: 1px solid #333; padding: 12px 14px; }
      .power-slot { width: 56px; display: flex; flex-direction: column; align-items: center; gap: 4px; }
      .power-slot-icon {
        display: block;
        width: 56px;
        height: 56px;
        background: #111;
        border: 2px solid #668;
        border-radius: 6px;
        object-fit: cover;
        cursor: pointer;
      }
      .power-slot-icon:hover { border-color: #9ac; }
      .power-slot-icon.empty { border-style: dashed; opacity: 0.35; cursor: default; }
      .power-slot-icon.disabled { cursor: default; opacity: 0.5; border-color: #444; }
      .power-slot-icon.ability-icon-fallback { display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: #9ab; background: #182028; border-style: dashed; }
      .power-slot select { width: 56px; font-size: 9px; padding: 2px; }

      .preview-status { font-size: 12px; color: #999; min-height: 1.2em; padding: 4px 14px; background: #1c2126; }

      a.back-link { position: absolute; top: 10px; left: 10px; color: #9ab; font-size: 13px; z-index: 1; background: rgba(0,0,0,0.5); padding: 4px 8px; border-radius: 3px; text-decoration: none; }
    </style>
  </head>
  <body>
    <%= yield %>
    <%= vite_script_tags("src/unitTypeEditor/main.jsx", "/client/unitTypeEditor.js") %>
  </body>
</html>
