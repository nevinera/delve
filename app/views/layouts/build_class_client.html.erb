<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Delve - Class Editor</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
<%= render "layouts/content_editor_styles" %>

      .config-warning { font-size: 12px; color: #eb7; margin: 0 0 8px; }

      .class-dps-estimate .strategy-editor-table { font-size: 12px; }
      .class-dps-estimate .strategy-editor-table select, .class-dps-estimate .strategy-editor-table input[type=text] { width: auto; min-width: 80px; }
      .class-dps-estimate .strategy-editor-table button { background: #333; border: 1px solid #555; color: #ccc; font-size: 11px; padding: 2px 6px; border-radius: 3px; cursor: pointer; margin-right: 2px; }
      .class-dps-estimate .strategy-editor-table button:disabled { opacity: 0.4; cursor: default; }
      .class-dps-estimate button.strategy-editor-add { background: #234; border: 1px solid #457; color: #9cf; font-size: 12px; padding: 5px 10px; border-radius: 3px; cursor: pointer; margin-bottom: 14px; }
      .class-dps-estimate-header { display: flex; align-items: center; gap: 10px; }
      .class-dps-estimate .estimate-dps-button { background: #234; border: 1px solid #457; color: #9cf; font-size: 13px; font-weight: 600; padding: 6px 16px; border-radius: 3px; cursor: pointer; }
      .class-dps-estimate .estimate-dps-button:disabled { background: #333; border-color: #555; color: #888; cursor: default; }
      .class-dps-estimate-error { font-size: 12px; color: #e79; }
      .content-editor-fields .class-dps-estimate-table { margin-top: 10px; font-size: 12px; }
    </style>
  </head>
  <body>
    <%= yield %>
    <%= vite_script_tags("src/classEditor/main.jsx", "/client/classEditor.js") %>
  </body>
</html>
