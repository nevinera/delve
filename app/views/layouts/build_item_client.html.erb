<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Delve - Item Editor</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body, #editor-root { width: 100%; height: 100%; }
      body { background: #14181c; color: #ddd; font-family: system-ui, sans-serif; overflow: hidden; }

      .item-editor { display: flex; height: 100%; }
      .item-editor-preview { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20px; padding: 14px; }
      .item-editor-fields { flex: 1; min-width: 0; overflow-y: auto; padding: 14px; background: #1c2126; border-left: 1px solid #333; }

      @media (max-width: 700px) {
        .item-editor { flex-direction: column; }
        .item-editor-preview { flex: none; height: 30vh; }
        .item-editor-fields { flex: 1; width: 100%; border-left: none; border-top: 1px solid #333; }
      }

      .item-editor-fields table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
      .item-editor-fields th { text-align: left; padding: 4px 8px 4px 0; color: #9ab; font-weight: normal; white-space: nowrap; vertical-align: top; }
      .item-editor-fields td { padding: 4px 0; word-break: break-word; }
      .item-editor-fields input[type=number] { width: 100px; background: #111; border: 1px solid #555; color: #eee; padding: 3px 6px; border-radius: 3px; }
      .item-editor-fields input[type=text] { width: 100%; background: #111; border: 1px solid #555; color: #eee; padding: 3px 6px; border-radius: 3px; }
      .item-editor-fields select { width: 100%; background: #111; border: 1px solid #555; color: #eee; padding: 3px 6px; border-radius: 3px; }
      .item-editor-fields .checkbox-list { display: flex; flex-wrap: wrap; gap: 10px; }
      .item-editor-fields .checkbox-list label { display: flex; align-items: center; gap: 4px; font-size: 12px; }

      .save-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
      .save-bar .validate-button { background: #245; border: 1px solid #47a; color: #dee; font-size: 13px; font-weight: 600; padding: 6px 16px; border-radius: 3px; cursor: pointer; }
      .save-bar .validate-button:hover:not(:disabled) { background: #356; }
      .save-bar .validate-button:disabled { background: #333; border-color: #555; color: #888; cursor: default; }
      .save-bar .save-button { background: #2a4; border: 1px solid #4c7; color: #efe; font-size: 13px; font-weight: 600; padding: 6px 16px; border-radius: 3px; cursor: pointer; }
      .save-bar .save-button:hover:not(:disabled) { background: #3b5; }
      .save-bar .save-button:disabled { background: #333; border-color: #555; color: #888; cursor: default; }
      .save-bar .save-message { font-size: 12px; }
      .save-bar .save-success { color: #7c7; }
      .save-bar .save-error { color: #e79; }

      .item-preview-elvl-control { display: flex; align-items: center; gap: 8px; font-size: 12px; color: #9ab; }
      .item-preview-elvl-control input { width: 90px; background: #111; border: 1px solid #555; color: #eee; padding: 3px 6px; border-radius: 3px; }

      a.back-link { position: absolute; top: 10px; left: 10px; color: #9ab; font-size: 13px; z-index: 1; background: rgba(0,0,0,0.5); padding: 4px 8px; border-radius: 3px; text-decoration: none; }
    </style>
  </head>
  <body>
    <%= yield %>
    <%= vite_script_tags("src/itemEditor/main.jsx", "/client/itemEditor.js") %>
  </body>
</html>
