<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Delve - Zone Editor</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: #14181c; color: #ddd; font-family: system-ui, sans-serif; }

      .zone-editor { max-width: 480px; margin: 40px auto; padding: 0 14px; }
      .zone-editor-fields table { width: 100%; border-collapse: collapse; margin-bottom: 14px; }
      .zone-editor-fields th { text-align: left; padding: 4px 8px 4px 0; color: #9ab; font-weight: normal; white-space: nowrap; }
      .zone-editor-fields td { padding: 4px 0; }
      .zone-editor-fields input[type=text] { width: 100%; background: #111; border: 1px solid #555; color: #eee; padding: 3px 6px; border-radius: 3px; }

      .save-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
      .save-bar .save-button { background: #2a4; border: 1px solid #4c7; color: #efe; font-size: 13px; font-weight: 600; padding: 6px 16px; border-radius: 3px; cursor: pointer; }
      .save-bar .save-button:hover:not(:disabled) { background: #3b5; }
      .save-bar .save-button:disabled { background: #333; border-color: #555; color: #888; cursor: default; }
      .save-bar .save-message { font-size: 12px; }
      .save-bar .save-success { color: #7c7; }
      .save-bar .save-error { color: #e79; }
    </style>
  </head>
  <body>
    <%= yield %>
    <%= vite_script_tags("src/zoneEditor/main.jsx", "/client/zoneEditor.js") %>
  </body>
</html>
