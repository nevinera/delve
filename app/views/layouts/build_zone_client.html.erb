<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Delve - Zone Editor</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: #14181c; color: #ddd; font-family: system-ui, sans-serif; }

      .zone-editor { max-width: 640px; margin: 40px auto; padding: 0 14px; }
      .zone-editor-fields table { width: 100%; border-collapse: collapse; margin-bottom: 14px; }
      .zone-editor-fields th { text-align: left; padding: 4px 8px 4px 0; color: #9ab; font-weight: normal; white-space: nowrap; }
      .zone-editor-fields td { padding: 4px 0; }
      .zone-editor-fields input[type=text] { width: 100%; background: #111; border: 1px solid #555; color: #eee; padding: 3px 6px; border-radius: 3px; }

      .save-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
      .save-bar .save-button { background: #2a4; border: 1px solid #4c7; color: #efe; font-size: 13px; font-weight: 600; padding: 6px 16px; border-radius: 3px; cursor: pointer; }
      .save-bar .save-button:hover:not(:disabled) { background: #3b5; }
      .save-bar .save-button:disabled { background: #333; border-color: #555; color: #888; cursor: default; }
      .save-bar .save-message { font-size: 12px; }
      .save-bar .save-success { color: #7c7; }
      .save-bar .save-error { color: #e79; }

      /* Same collapsible-section-heading and entry-block/remove-entry/
         add-entry conventions the map editor's sidebar uses (see
         build_map_client.html.erb) - reused here rather than reinvented. */
      .map-sidebar-section-heading { display: flex; align-items: center; gap: 6px; cursor: pointer; padding: 6px 0; }
      .map-sidebar-section-heading h3 { font-size: 13px; color: #cce; font-weight: 600; }
      .map-sidebar-section-toggle { font-size: 11px; color: #9ab; width: 1em; text-align: center; }
      .map-sidebar-hint { color: #987; font-size: 12px; margin: 4px 0 8px; }
      .map-sidebar-unit-type-links { font-size: 11px; color: #9ab; margin: 4px 0; }

      .entry-block { margin: 8px 0; padding: 6px 0; border-top: 1px solid #2a2f35; border-radius: 4px; }
      .entry-heading-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; cursor: pointer; }
      .map-row-summary { display: flex; align-items: center; gap: 8px; min-width: 0; flex: 1; }
      button.remove-entry { background: #422; border: 1px solid #644; color: #e9a; font-size: 11px; padding: 3px 8px; border-radius: 3px; cursor: pointer; flex-shrink: 0; }
      button.remove-entry:hover { background: #533; }
      .add-buttons-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 8px 0; }
      button.add-entry { background: #234; border: 1px solid #457; color: #9cf; font-size: 12px; padding: 5px 10px; border-radius: 3px; cursor: pointer; }
      button.add-entry:hover { background: #345; }
      button.add-entry:disabled { opacity: 0.4; cursor: default; }
      .add-buttons-row select { background: #111; border: 1px solid #555; color: #eee; font-size: 12px; padding: 4px 6px; border-radius: 3px; }
      .add-buttons-row a { color: #9cf; font-size: 12px; }

      .zone-map-thumb { width: 40px; height: 40px; object-fit: cover; border-radius: 4px; background: #223; flex-shrink: 0; }
      .zone-map-thumb-placeholder { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; font-size: 18px; background: #223; border-radius: 4px; flex-shrink: 0; }
      .zone-map-name { font-size: 13px; color: #cce; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

      .zone-connections-list { margin: 8px 0 4px 20px; }
      .zone-connection-row { padding: 4px 0; }
      .zone-connection-row .map-row-summary { flex: 0 0 auto; gap: 6px; }
      .zone-connection-name { font-size: 13px; color: #cce; font-weight: 600; }
      .zone-connection-type { font-size: 12px; color: #789; }
      .zone-connection-status { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 4px 0 0; font-size: 12px; color: #9ab; }
      .zone-connection-status-label { color: #9ab; }
      .zone-connection-status input[type=text] { width: 140px; background: #111; border: 1px solid #555; color: #eee; padding: 3px 6px; border-radius: 3px; font-size: 12px; }
      .zone-connection-status label { display: flex; align-items: center; gap: 4px; }

      /* Same top-left overlay convention as the item/unit_type/class/
         ability editors' own back-link (see build_item_client.html.erb). */
      a.back-link {
        position: absolute; top: 10px; left: 10px; color: #9ab; font-size: 13px; z-index: 1;
        background: rgba(0,0,0,0.5); padding: 4px 8px; border-radius: 3px; text-decoration: none;
      }
    </style>
  </head>
  <body>
    <%= yield %>
    <%= vite_script_tags("src/zoneEditor/main.jsx", "/client/zoneEditor.js") %>
  </body>
</html>
