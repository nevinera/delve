<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Delve character builder" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/delve-icon.png" type="image/png">
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json, v: 2) %>
    <%= vite_stylesheet_tags "src/character/builder.js" %>
    <%= vite_script_tags "src/character/builder.js", "/client/characterBuilder.js" %>
  </head>

  <body class="builder">
    <%= yield %>
  </body>
</html>
