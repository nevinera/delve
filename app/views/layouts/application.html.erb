<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <title><%= content_for(:title) || "Delve" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Delve">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#0e0c12">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# The importmap comes before any module script, or Firefox ignores it. %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/delve-icon.png" type="image/png">
    <link rel="icon" href="/delve-icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/delve-icon.png">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2.0.6/css/pico.classless.min.css">
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body>
    <header>
      <nav>
        <ul>
          <li><%= link_to root_path, class: "site-name" do %><strong>Delve</strong><% end %></li>
        </ul>
        <ul>
          <% if user_signed_in? %>
            <li><%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "compact" %></li>
          <% elsif !current_page?(new_user_session_path) %>
            <li><%= link_to "Sign in", new_user_session_path %></li>
          <% end %>
        </ul>
      </nav>
    </header>

    <main>
      <% if notice %><article role="alert"><%= notice %></article><% end %>
      <% if alert %><article role="alert" class="alert"><%= alert %></article><% end %>
      <%= yield %>
    </main>
  </body>
</html>
