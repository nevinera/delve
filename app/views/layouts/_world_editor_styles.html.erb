<%# Styles for the single-page world editor (see plans/world-editor/), on
    top of the shared content_editor_styles grid. %>
      /* Header: breadcrumbs, branch, unsaved work, the pipeline. */
      .world-builder-header { flex-wrap: wrap; row-gap: 6px; }
      .world-builder-header .config-breadcrumbs { margin: 0; padding: 0; border: none; font-size: 14px; }
      .world-builder-header .header-spacer { flex: 1; }
      .branch-picker { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #9ab; }
      .branch-picker select, .branch-picker input { background: #111; border: 1px solid #555; color: #eee; padding: 3px 6px; border-radius: 3px; font-size: 12px; }
      .branch-picker button { background: #234; border: 1px solid #457; color: #9cf; font-size: 12px; padding: 3px 8px; border-radius: 3px; cursor: pointer; }
      .branch-picker .branch-error { color: #e79; }
      .unsaved-indicator { font-size: 12px; color: #9ab; }
      .unsaved-indicator.has-changes { color: #eb7; }
      .unsaved-indicator.heavy { color: #f96; font-weight: 600; }
      .pipeline { display: flex; align-items: center; gap: 6px; }
      .pipeline button { background: #245; border: 1px solid #47a; color: #dee; font-size: 13px; font-weight: 600; padding: 5px 12px; border-radius: 3px; cursor: pointer; }
      .pipeline button:hover:not(:disabled) { background: #356; }
      .pipeline button.save-button { background: #2a4; border-color: #4c7; color: #efe; }
      .pipeline button:disabled { background: #333; border-color: #555; color: #888; cursor: default; }
      .pipeline-status { font-size: 12px; color: #9ab; flex-basis: 100%; text-align: right; }
      .pipeline-status.error { color: #e79; }
      .save-prompt { display: flex; gap: 6px; }
      .save-prompt input { background: #111; border: 1px solid #555; color: #eee; padding: 3px 6px; border-radius: 3px; font-size: 12px; width: 220px; }

      /* Full-page notices: loading, errors, resume, create. */
      .world-builder-notice { max-width: 560px; margin: 60px auto; padding: 20px; background: #1c2126; border: 1px solid #333; border-radius: 6px; display: flex; flex-direction: column; gap: 12px; }
      .world-builder-span { grid-column: 1 / -1; align-self: start; }
      .world-builder-notice h2 { font-size: 16px; color: #cce; }
      .world-builder-notice p { font-size: 13px; color: #9ab; }
      .world-builder-notice .notice-error { color: #e79; }
      .world-builder-notice .notice-actions { display: flex; gap: 8px; }
      .world-builder-notice button { background: #234; border: 1px solid #457; color: #9cf; font-size: 13px; padding: 6px 12px; border-radius: 3px; cursor: pointer; }
      .world-builder-notice input { background: #111; border: 1px solid #555; color: #eee; padding: 5px 8px; border-radius: 3px; }

      /* Graph canvases (WorldGraphCanvas, ZoneGraphCanvas). */
      .zone-graph-panel { flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 10px 14px; }
      .zone-graph-toolbar { display: flex; align-items: center; gap: 4px; margin-bottom: 6px; flex: 0 0 auto; }
      .zone-graph-toolbar button {
        background: #234; border: 1px solid #457; color: #9cf; font-size: 13px; font-weight: 600;
        padding: 4px 10px; border-radius: 3px; cursor: pointer;
      }
      .zone-graph-toolbar button:hover { background: #345; }
      .zone-graph-wrapper {
        flex: 1; min-height: 0; border: 1px solid #333; border-radius: 4px; background: #0a0c0e;
        background-image: linear-gradient(45deg, #101316 25%, transparent 25%), linear-gradient(-45deg, #101316 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #101316 75%), linear-gradient(-45deg, transparent 75%, #101316 75%);
        background-size: 20px 20px; background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
        touch-action: none; cursor: grab; overflow: hidden;
      }
      .zone-graph-wrapper:active { cursor: grabbing; }
      .zone-graph-node { fill: #1c2126; stroke: #457; stroke-width: 2; cursor: grab; }
      .zone-graph-node:active { cursor: grabbing; }
      .zone-graph-node-label { fill: #cce; font-size: 12px; text-anchor: middle; pointer-events: none; }
      .zone-graph-node-thumb-placeholder { font-size: 22px; pointer-events: none; }
      .zone-graph-port { cursor: crosshair; stroke: #000; stroke-width: 1; }
      .zone-graph-edge { stroke: #59c; stroke-width: 2; }
      .zone-graph-drag-line { stroke: #fd0; stroke-width: 2; stroke-dasharray: 4 3; }
      .zone-graph-satellite { stroke: #000; stroke-width: 1; cursor: grab; }
      .zone-graph-satellite:active { cursor: grabbing; }
      .zone-graph-satellite-tether { stroke: #667; stroke-width: 1; stroke-dasharray: 3 3; }
      .zone-graph-satellite-label { fill: #cce; font-size: 11px; text-anchor: middle; pointer-events: none; }

      /* Panels reused from the old world/zone editors. */
      .world-builder h3 { font-size: 15px; color: #cce; font-weight: 600; margin: 24px 0 10px; border-top: 1px solid #2a2f35; padding-top: 20px; }
      .world-builder h4 { font-size: 13px; color: #cce; font-weight: 600; }
      .world-builder table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
      .world-builder th { text-align: left; padding: 4px 8px 4px 0; color: #9ab; font-weight: normal; white-space: nowrap; vertical-align: top; width: 100px; }
      .world-builder td { padding: 4px 0; word-break: break-word; }
      .world-builder input[type=text], .world-builder input[type=number] { width: 100%; background: #111; border: 1px solid #555; color: #eee; padding: 3px 6px; border-radius: 3px; }
      .world-builder select { background: #111; border: 1px solid #555; color: #eee; padding: 3px 6px; border-radius: 3px; margin-right: 6px; }
      .world-builder .range-field { display: inline-flex; align-items: center; gap: 6px; }
      .world-builder .range-field input[type=number] { width: 90px; }
      .world-builder .range-sep { color: #667; }
      .world-builder .world-thumbnail-field { display: flex; flex-direction: column; gap: 4px; }
      .world-builder .world-thumbnail-preview { max-width: 128px; max-height: 128px; border: 1px solid #334; }
      .world-builder .entry-block { margin: 8px 0; padding: 8px 10px; border: 1px solid #2a2f35; border-radius: 4px; }
      .world-builder .entry-heading-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
      .world-builder .map-row-summary { display: flex; align-items: center; gap: 8px; }
      .world-builder .zone-connection-name { font-size: 13px; color: #cce; font-weight: 600; }
      .world-builder .zone-connection-status { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 4px; font-size: 12px; color: #9ab; }
      .world-builder .zone-connection-status input[type=text] { width: 160px; }
      .world-builder .map-sidebar-hint { color: #987; font-size: 12px; margin: 4px 0 8px; }
      .world-builder .add-buttons-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 8px 0; }
      .world-builder button.add-entry { background: #234; border: 1px solid #457; color: #9cf; font-size: 12px; padding: 5px 10px; border-radius: 3px; cursor: pointer; }
      .world-builder button.add-entry:hover { background: #345; }
      .world-builder button.add-entry:disabled { opacity: 0.4; cursor: default; }
      .world-builder button.remove-entry { background: #422; border: 1px solid #644; color: #e9a; font-size: 11px; padding: 3px 8px; border-radius: 3px; cursor: pointer; flex-shrink: 0; }
      .world-builder button.remove-entry:hover { background: #533; }
      .world-builder button.remove-entry:hover { background: #533; }

      /* World level. */
      .world-attributes { flex: 2; min-height: 0; overflow-y: auto; padding: 10px 14px; background: #171b1f; border-top: 1px solid #333; }
      .world-attributes h3 { margin-top: 0; border-top: none; padding-top: 0; }
      .world-attributes .world-key { font-size: 12px; color: #9ab; margin-bottom: 8px; }
      .zone-list .zone-list-heading { display: flex; align-items: center; justify-content: space-between; }
      .zone-list .zone-list-heading h3 { margin: 0; border: none; padding: 0; }
      .zone-list ul { list-style: none; margin: 8px 0; display: flex; flex-direction: column; gap: 4px; }
      .zone-list .zone-row { display: flex; align-items: center; gap: 6px; padding: 4px; border: 1px solid #2a2f35; border-radius: 4px; }
      .zone-list button.zone-row-open { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; background: none; border: none; color: #ddd; text-align: left; cursor: pointer; padding: 4px 6px; }
      .zone-list button.zone-row-open:hover { background: #1f262c; }
      .zone-list .zone-row-name { font-size: 13px; font-weight: 600; color: #cce; }
      .zone-list .zone-row-key { font-size: 11px; color: #9ab; }
      .zone-list .zone-form { display: flex; flex: 1; flex-wrap: wrap; gap: 6px; margin: 6px 0; }
      .zone-list .zone-form input { flex: 1; min-width: 120px; background: #111; border: 1px solid #555; color: #eee; padding: 3px 6px; border-radius: 3px; }
      .zone-list .zone-list-error { color: #e79; font-size: 12px; }

      /* Zone level panels, from the old zone editor. */
      .map-sidebar-section-heading { display: flex; align-items: center; gap: 6px; cursor: pointer; padding: 6px 0; }
      .map-sidebar-section-heading h3 { font-size: 13px; color: #cce; font-weight: 600; }
      .map-sidebar-section-toggle { font-size: 11px; color: #9ab; width: 1em; text-align: center; }
      .map-sidebar-hint { color: #987; font-size: 12px; margin: 4px 0 8px; }
      .map-sidebar-unit-type-links { font-size: 11px; color: #9ab; margin: 4px 0; }
      .entry-block { margin: 8px 0; padding: 6px 0; border-top: 1px solid #2a2f35; border-radius: 4px; }
      .entry-heading-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; cursor: pointer; }
      .map-row-summary { display: flex; align-items: center; gap: 8px; min-width: 0; flex: 1; }
      .add-buttons-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 8px 0; }
      .add-buttons-row select { background: #111; border: 1px solid #555; color: #eee; font-size: 12px; padding: 4px 6px; border-radius: 3px; }
      .add-buttons-row a { color: #9cf; font-size: 12px; }
      .zone-map-thumb { width: 40px; height: 40px; object-fit: cover; border-radius: 4px; background: #223; flex-shrink: 0; }
      .zone-map-thumb-placeholder { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; font-size: 18px; background: #223; border-radius: 4px; flex-shrink: 0; }
      .zone-map-name { font-size: 13px; color: #cce; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .zone-map-edit-link { color: #9cf; font-size: 12px; flex-shrink: 0; margin-left: 8px; }
      .zone-connections-list { margin: 8px 0 4px 20px; }
      .zone-connection-row { padding: 4px 0; }
      .zone-connection-row .map-row-summary { flex: 0 0 auto; gap: 6px; }
      .zone-connection-name { font-size: 13px; color: #cce; font-weight: 600; }
      .zone-connection-type { font-size: 12px; color: #789; }
      .zone-connection-status { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 4px 0 0; font-size: 12px; color: #9ab; }
      .zone-connection-status-label { color: #9ab; }
      .zone-connection-status input[type=text] { width: 140px; background: #111; border: 1px solid #555; color: #eee; padding: 3px 6px; border-radius: 3px; font-size: 12px; }
      .zone-item-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
      .zone-item-name { font-size: 13px; color: #cce; font-weight: 600; }
      .zone-item-invalid { color: #e79; cursor: help; }
      .zone-item-usage { font-size: 12px; color: #9ab; }
      .zone-item-usage a { color: #9cf; }
      .world-builder .zone-missing-refs { font-size: 12px; color: #eb7; background: #2a2416; border: 1px solid #554; border-radius: 4px; padding: 6px 8px; margin-bottom: 10px; }
      .world-builder .world-attributes input[type=text] { width: 100%; }
