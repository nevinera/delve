<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Delve - Map Editor</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body, #editor-root { width: 100%; height: 100%; }
      body { background: #14181c; color: #ddd; font-family: system-ui, sans-serif; overflow: hidden; }

<%= render "layouts/map_editor_styles" %>
    </style>
  </head>
  <body>
    <%= yield %>
    <%= vite_script_tags("src/mapEditor/main.jsx", "/client/mapEditor.js") %>
  </body>
</html>
