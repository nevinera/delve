<h1>New Unit Type</h1>

<%= form_with url: build_unit_types_path, method: :post do %>
  <div>
    <label for="key">Key</label>
    <%= text_field_tag :key, @key, placeholder: "goblin-raider" %>
  </div>
  <p style="font-size: 0.85em; color: #666;">Use "/" to place it in a subdirectory, e.g. "goblins/raider".</p>

  <%= submit_tag "Create" %>
<% end %>

<%= link_to "Cancel", build_unit_types_path %>
