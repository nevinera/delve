<h1>Build</h1>

<% if @installation.repo_full_name.blank? %>
  <p>You don't have a repository selected.</p>
<% else %>
  <p>
    You have connected GitHub repository
    "<%= link_to @installation.repo_full_name, "https://github.com/#{@installation.repo_full_name}" %>".
  </p>

  <ul>
    <li><%= link_to "Abilities", build_abilities_path %></li>
    <li><%= link_to "Zones", build_zones_path %></li>
    <li><%= link_to "Character classes", build_character_classes_path %></li>
    <li><%= link_to "Handles", build_handles_path %></li>
  </ul>
<% end %>

<p><%= link_to "Manage GitHub connection", github_manage_path, style: "font-size: 0.8em;" %></p>
