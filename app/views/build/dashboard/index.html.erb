<h1>Build</h1>

<% if @local_content %>
  <p><%= link_to "Play a local zone", build_local_zones_path %> (from your local content server, no GitHub needed)</p>
<% end %>

<% if @installation.nil? %>
  <p><%= link_to "Connect GitHub", github_connect_path %> to edit and publish content.</p>
<% elsif @installation.repo_full_name.blank? %>
  <p>You don't have a repository selected.</p>
<% else %>
  <p>
    You have connected GitHub repository
    "<%= link_to @installation.repo_full_name, "https://github.com/#{@installation.repo_full_name}" %>".
  </p>

  <ul>
    <li><%= link_to "Abilities", build_abilities_path %></li>
    <li><%= link_to "Character classes", build_classes_path %></li>
    <li><%= link_to "Unit types", build_unit_types_path %></li>
    <li><%= link_to "Items", build_items_path %></li>
    <li><%= link_to "Maps", build_maps_path %></li>
    <li><%= link_to "Zones", build_zones_path %></li>
    <li><%= link_to "Worlds", build_worlds_path %></li>
  </ul>
<% end %>

<% if @installation %>
  <p><%= link_to "Manage GitHub connection", github_manage_path, style: "font-size: 0.8em;" %></p>
<% end %>
