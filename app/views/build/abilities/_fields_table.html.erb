<table>
  <tbody>
    <% fields.each do |key, value| %>
      <tr>
        <th><%= field_label(key) %></th>
        <td>
          <% case asset_media_kind(key, value, thumbnails, fields) %>
          <% when :sprite %>
            <%= sprite_preview_tag(thumbnails[value], fields) %>
            <div class="asset-url"><%= value %></div>
          <% when :image %>
            <img src="<%= thumbnails[value] %>" alt="<%= field_label(key) %>" class="asset-thumbnail">
            <div class="asset-url"><%= value %></div>
          <% when :audio %>
            <audio controls src="<%= thumbnails[value] %>" class="asset-audio"></audio>
            <div class="asset-url"><%= value %></div>
          <% else %>
            <%= format_value(value) %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
