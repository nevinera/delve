<h1><%= params[:id] %></h1>

<p><%= link_to "Edit", edit_build_ability_path(params[:id]) %></p>

<%= render "fields_table", fields: scalar_fields(@ability), thumbnails: @asset_thumbnails %>

<% list_fields(@ability).each do |key, entries| %>
  <details>
    <summary><%= field_label(key) %> (<%= entries.size %>)</summary>
    <% entries.each_with_index do |entry, index| %>
      <details>
        <summary><%= entry_summary(entry, index) %></summary>
        <%= render "fields_table", fields: entry, thumbnails: @asset_thumbnails %>
      </details>
    <% end %>
  </details>
<% end %>

<%= link_to "Back to Abilities", build_abilities_path %>
