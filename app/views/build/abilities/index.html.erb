<h1>Abilities</h1>

<%= render "build/shared/branch_picker", url: build_abilities_path %>

<p><%= link_to "New Ability", new_build_ability_path(branch: @branch) %></p>

<ul class="entry-list">
  <% @abilities.each do |entry| %>
    <% identifier = entry["path"].delete_prefix("abilities/").delete_suffix(".json") %>
    <li><span class="entry-title"><%= link_to identifier, edit_build_ability_path(id: identifier, branch: @branch) %></span></li>
  <% end %>
</ul>

<%= link_to "Back to Build", build_root_path %>
