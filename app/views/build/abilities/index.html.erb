<h1>Abilities</h1>

<p><%= link_to "New Ability", new_build_ability_path %></p>

<ul>
  <% @abilities.each do |entry| %>
    <% identifier = entry["name"].sub(/\.json\z/, "") %>
    <li><%= link_to identifier, edit_build_ability_path(id: identifier) %></li>
  <% end %>
</ul>

<%= link_to "Back to Build", build_root_path %>
