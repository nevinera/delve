<h1>New Ability</h1>

<%= form_with url: build_abilities_path, method: :post do %>
  <div>
    <label for="key">Key</label>
    <%= text_field_tag :key, @key, placeholder: "classes/druid/wildshape" %>
  </div>
  <p style="font-size: 0.85em; color: #666;">Use "/" to place it in a subdirectory, e.g. "classes/druid/wildshape" or "units/goblin-archer".</p>

  <%= submit_tag "Create" %>
<% end %>

<%= link_to "Cancel", build_abilities_path %>
