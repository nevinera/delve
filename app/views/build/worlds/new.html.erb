<h1>New World</h1>

<%= form_with url: build_worlds_path, method: :post do %>
  <%= hidden_field_tag :branch, @branch %>
  <div>
    <label for="key">Key</label>
    <%= text_field_tag :key, @key, placeholder: "northern-barrens" %>
  </div>
  <p style="font-size: 0.85em; color: #666;">Letters, numbers, "_" and "-".</p>

  <%= submit_tag "Create" %>
<% end %>

<%= link_to "Cancel", build_worlds_path %>
