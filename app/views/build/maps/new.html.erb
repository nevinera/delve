<h1>New Map</h1>

<%= form_with url: build_maps_path, method: :post do %>
  <div>
    <label for="key">Key</label>
    <%= text_field_tag :key, @key, placeholder: "goblin-cave/gc1-goblin-cave-entrance" %>
  </div>
  <p style="font-size: 0.85em; color: #666;">
    Place it under its zone's key, e.g. "goblin-cave/gc1-goblin-cave-entrance" - a map is stored at
    zones/&lt;key&gt;/&lt;last segment&gt;.json.
  </p>

  <%= submit_tag "Create" %>
<% end %>

<%= link_to "Cancel", build_maps_path %>
