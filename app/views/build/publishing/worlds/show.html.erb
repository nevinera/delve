<% if @versions.any?(&:importing?) %>
  <% content_for :head do %><meta http-equiv="refresh" content="3"><% end %>
<% end %>

<h1><%= @world.key %></h1>

<p>
  <%= link_to "#{@world.repo}/#{@world.path}", "https://github.com/#{@world.repo}/blob/HEAD/#{@world.path}" %>
  <% if (editor_path = world_editor_path_for(@world.path)) %> · <%= link_to "Edit", editor_path %><% end %>
</p>

<p><%= link_to "Add a version from an existing tag", new_build_publishing_world_version_path(@world) %></p>

<table>
  <thead>
    <tr>
      <th>Tag</th><th>State</th><th>Commit</th>
      <th>Imported</th><th>Released</th><th>Expires</th><th></th>
    </tr>
  </thead>
  <tbody>
    <% @versions.each do |version| %>
      <tr>
        <td><%= version.ref %></td>
        <td><%= version.expired? ? "expired" : version.state %></td>
        <td><%= version.commit_sha&.first(7) %></td>
        <td><%= version.imported_at&.to_fs(:short) %></td>
        <td><%= version.released_at&.to_fs(:short) %></td>
        <td><%= version.expires_at&.to_fs(:short) %></td>
        <td>
          <% if version.unreleased? %>
            <%= button_to "Release", release_build_publishing_world_version_path(@world, version),
                  data: {confirm: "Release #{version.ref}? Earlier versions expire in 24 hours."} %>
          <% end %>
          <% if version.failed? %>
            <%= button_to "Reimport", reimport_build_publishing_world_version_path(@world, version) %>
          <% end %>
        </td>
      </tr>
      <% if version.validity_error.present? %>
        <tr><td colspan="7"><strong>Import error:</strong> <%= version.validity_error %></td></tr>
      <% end %>
    <% end %>
  </tbody>
</table>

<%= link_to "All published worlds", build_publishing_worlds_path %>
