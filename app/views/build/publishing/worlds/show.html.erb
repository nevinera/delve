<% if @versions.any?(&:importing?) %>
  <% content_for :head do %><meta http-equiv="refresh" content="3"><% end %>
<% end %>

<h1><%= @world.key %></h1>

<p>
  <%= link_to "#{@world.repo}/#{@world.path}", "https://github.com/#{@world.repo}/blob/HEAD/#{@world.path}" %>
  <% if (editor_path = world_editor_path_for(@world.path)) %> · <%= link_to "Edit", editor_path %><% end %>
</p>

<p><%= link_to "Add a version from an existing tag", new_build_publishing_world_version_path(@world) %></p>

<% if @unimported_tags.nil? %>
  <p><small>Tags in <%= @world.repo %> can't be listed here; connect GitHub to that repo to import them.</small></p>
<% end %>

<ul class="entry-list">
  <% @rows.each do |row| %>
    <% if row.is_a?(String) %>
      <li>
        <span class="entry-title"><%= row %></span>
        <span class="entry-state">not imported</span>
        <%= button_to "Import", build_publishing_world_versions_path(@world), params: {world_version: {ref: row}}, class: "compact" %>
      </li>
    <% else %>
      <li>
        <span class="entry-title"><%= row.ref %></span>
        <span class="entry-state"><%= row.expired? ? "expired" : row.state %></span>
        <% if row.unreleased? %>
          <%= button_to "Release", release_build_publishing_world_version_path(@world, row), class: "compact",
                data: {confirm: "Release #{row.ref}? Earlier versions expire in 24 hours."} %>
        <% end %>
        <% if row.failed? %>
          <%= button_to "Reimport", reimport_build_publishing_world_version_path(@world, row), class: "compact" %>
        <% end %>
        <div class="entry-meta">
          <% if row.commit_sha %><span><code><%= row.commit_sha.first(7) %></code></span><% end %>
          <% if row.imported_at %><span>imported <%= row.imported_at.to_fs(:short) %></span><% end %>
          <% if row.released_at %><span>released <%= row.released_at.to_fs(:short) %></span><% end %>
          <% if row.expires_at %><span>expires <%= row.expires_at.to_fs(:short) %></span><% end %>
        </div>
        <% if row.validity_error.present? %>
          <div class="entry-error"><strong>Import error:</strong> <%= row.validity_error %></div>
        <% end %>
      </li>
    <% end %>
  <% end %>
</ul>

<%= link_to "All published worlds", build_publishing_worlds_path %>
