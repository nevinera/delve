<% if @versions.any?(&:importing?) %>
  <% content_for :head do %><meta http-equiv="refresh" content="3"><% end %>
<% end %>

<h1><%= @world.key %></h1>

<p>
  <%= link_to "#{@world.repo}/#{@world.path}", "https://github.com/#{@world.repo}/blob/HEAD/#{@world.path}" %>
  <% if (editor_path = world_editor_path_for(@world.path)) %> · <%= link_to "Edit", editor_path %><% end %>
</p>

<p><%= link_to "Add a version from an existing tag", new_build_publishing_world_version_path(@world) %></p>

<% if @unimported_tags.nil? %>
  <p><small>Tags in <%= @world.repo %> can't be listed here; connect GitHub to that repo to import them.</small></p>
<% end %>

<table>
  <thead>
    <tr>
      <th>Tag</th><th>State</th><th>Commit</th>
      <th>Imported</th><th>Released</th><th>Expires</th><th></th>
    </tr>
  </thead>
  <tbody>
    <% @rows.each do |row| %>
      <% if row.is_a?(String) %>
        <tr>
          <td><%= row %></td>
          <td>not imported</td>
          <td colspan="4"></td>
          <td>
            <%= button_to "Import", build_publishing_world_versions_path(@world), params: {world_version: {ref: row}} %>
          </td>
        </tr>
      <% else %>
        <tr>
          <td><%= row.ref %></td>
          <td><%= row.expired? ? "expired" : row.state %></td>
          <td><%= row.commit_sha&.first(7) %></td>
          <td><%= row.imported_at&.to_fs(:short) %></td>
          <td><%= row.released_at&.to_fs(:short) %></td>
          <td><%= row.expires_at&.to_fs(:short) %></td>
          <td>
            <% if row.unreleased? %>
              <%= button_to "Release", release_build_publishing_world_version_path(@world, row),
                    data: {confirm: "Release #{row.ref}? Earlier versions expire in 24 hours."} %>
            <% end %>
            <% if row.failed? %>
              <%= button_to "Reimport", reimport_build_publishing_world_version_path(@world, row) %>
            <% end %>
          </td>
        </tr>
        <% if row.validity_error.present? %>
          <tr><td colspan="7"><strong>Import error:</strong> <%= row.validity_error %></td></tr>
        <% end %>
      <% end %>
    <% end %>
  </tbody>
</table>

<%= link_to "All published worlds", build_publishing_worlds_path %>
