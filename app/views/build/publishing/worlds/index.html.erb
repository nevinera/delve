<h1>Published worlds</h1>

<p>Worlds you've set up for publishing. Set one up from its row in <%= link_to "Worlds", build_worlds_path %>.</p>

<ul class="entry-list">
  <% @worlds.each do |world| %>
    <li>
      <span class="entry-title"><%= link_to world.key, build_publishing_world_path(world) %></span>
      <span class="entry-state"><%= pluralize(world.world_versions.size, "version") %></span>
      <div class="entry-meta"><%= world.repo %></div>
    </li>
  <% end %>
</ul>

<%= link_to "Back to Build", build_root_path %>
