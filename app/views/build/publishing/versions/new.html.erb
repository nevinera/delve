<h1>Add a version from a tag</h1>

<p>The tag must already exist in <%= @world.repo %>. (The world editor's Publish button creates the tag for you.)</p>

<%= form_with model: @version, url: build_publishing_world_versions_path(@world) do |f| %>
  <div>
    <%= f.label :ref, "Tag" %>
    <%= f.text_field :ref %>
  </div>
  <%= f.submit "Import tag" %>
<% end %>

<%= link_to "Cancel", build_publishing_world_path(@world) %>
