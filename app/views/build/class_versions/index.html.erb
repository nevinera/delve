<% if @versions.any?(&:provided?) %>
  <% content_for :head do %><meta http-equiv="refresh" content="3"><% end %>
<% end %>

<h1><%= @key %> versions</h1>

<p><%= link_to "Edit", edit_build_class_path(id: @key) %></p>

<% if @unimported_versions.nil? %>
  <p><small>Tags in your repo couldn't be listed, so versions that aren't imported here are missing.</small></p>
<% end %>

<% if @rows.empty? %>
  <p>No versions yet. The class editor's Publish button tags and imports one.</p>
<% else %>
  <ul class="entry-list">
    <% @rows.each do |row| %>
      <% if row.is_a?(String) %>
        <li>
          <span class="entry-title"><%= row %></span>
          <span class="entry-state">not imported</span>
          <%= button_to "Import", build_class_versions_path(id: @key), params: {version: row}, class: "compact" %>
        </li>
      <% else %>
        <li>
          <span class="entry-title"><%= row.version %></span>
          <span class="entry-state"><%= row.provided? ? "importing" : row.state %></span>
          <div class="entry-meta">
            <% if row.name.present? %><span><%= row.name %></span><% end %>
            <span>imported <%= row.created_at.to_fs(:short) %></span>
          </div>
          <% if row.validity_error.present? %>
            <div class="entry-error"><strong>Import error:</strong> <%= row.validity_error %></div>
          <% end %>
        </li>
      <% end %>
    <% end %>
  </ul>
<% end %>

<%= link_to "All classes", build_classes_path %>
