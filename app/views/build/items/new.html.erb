<h1>New Item</h1>

<%= form_with url: build_items_path, method: :post do %>
  <div>
    <label for="key">Key</label>
    <%= text_field_tag :key, @key, placeholder: "sword-of-doom" %>
  </div>
  <p style="font-size: 0.85em; color: #666;">Use "/" to place it in a subdirectory, e.g. "weapons/sword-of-doom".</p>

  <%= submit_tag "Create" %>
<% end %>

<%= link_to "Cancel", build_items_path %>
