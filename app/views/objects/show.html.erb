<% content_for :title, "Delve objects" %>
<div class="library-page">
  <header class="library-bar">
    <h2>Objects</h2>
    <span id="worldName" class="library-world"></span>
    <a href="/create">editor</a>
    <span id="worldBar" class="library-world-bar"></span>
    <span class="library-spacer"></span>
    <p id="message" class="editor-message"></p>
    <input id="repoMessage" placeholder="what you changed" aria-label="commit message" autocomplete="off">
    <button id="repoSave" type="button" disabled>save to GitHub</button>
  </header>
  <div id="gallery" class="editor-gallery"></div>
</div>
