<% content_for :title, "Creature - Delve" %>
<main class="creature">
  <div class="creature-view">
    <canvas id="stage" class="creature-stage"></canvas>
    <header class="creature-bar">
      <h1>Creature</h1>
      <button id="reroll" type="button">new look</button>
      <button id="pause" type="button">pause</button>
      <div id="roles" class="creature-roles"></div>
    </header>
    <div id="now" class="creature-now"></div>
  </div>
  <aside id="controls" class="creature-controls"></aside>
</main>
