<header class="editor-bar">
  <strong id="worldName"></strong>
  <span id="cursor" class="editor-cursor"></span>
  <span class="spacer"></span>
  <button id="upload" type="button">upload world</button>
  <input id="uploadFile" type="file" accept=".zip,application/zip" hidden>
  <button id="download" type="button">download world</button>
</header>
<main class="editor-main">
  <canvas id="map" class="editor-map"></canvas>
  <aside class="editor-panel">
    <section>
      <h2>Continent</h2>
      <select id="continent"></select>
    </section>
    <section>
      <h2>Zones</h2>
      <ul id="zoneList" class="editor-zones"></ul>
      <button id="newZone" type="button">new zone</button>
    </section>
    <section id="zonePanel" hidden>
      <h2>Zone</h2>
      <label class="editor-field">name <input id="zoneName" type="text"></label>
      <p id="regionInfo"></p>
      <div class="editor-row">
        <button id="drawRegion" type="button">draw region</button>
        <button id="deleteZone" type="button">delete zone</button>
      </div>
      <div class="editor-row editor-subhead">
        <button id="generate" type="button">generate</button>
      </div>
      <h2 class="editor-subhead">Tools</h2>
      <div id="tools" class="editor-tools"></div>
    </section>
    <section id="props" class="editor-props" hidden></section>
    <p id="message" class="editor-message"></p>
    <p id="hint" class="editor-hint"></p>
  </aside>
</main>
