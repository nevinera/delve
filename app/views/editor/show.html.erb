<header class="editor-bar">
  <strong id="worldName"></strong>
  <span id="cursor" class="editor-cursor"></span>
  <span class="spacer"></span>
  <button id="newWorld" type="button">new world</button>
  <button id="upload" type="button">upload world</button>
  <button id="loadDefault" type="button" title="Loads the shared default world from this server">load default</button>
  <input id="uploadFile" type="file" accept=".zip,application/zip" hidden>
  <button id="download" type="button">download world</button>
</header>
<main class="editor-main">
  <div class="editor-view">
    <nav class="editor-view-bar">
      <span id="scaleBar" class="editor-scale">
        <button id="zoomOut" type="button" title="zoom out (V)">−</button>
        <span id="scale"></span>
        <button id="zoomIn" type="button" title="zoom in (C)">+</button>
      </span>
      <span class="spacer"></span>
      <button id="walk" type="button" title="walk (G)">walk</button>
      <button id="timeButton" type="button" popovertarget="timePanel" hidden>time</button>
      <div id="timePanel" class="editor-popover" popover>
        <h3>Time</h3>
        <label class="editor-range">time <input id="timeOfDay" type="range" min="0" max="1" step="0.001"><output id="timeOfDayValue"></output></label>
        <label class="editor-range">moon <input id="moonDay" type="range" min="0" step="1"><output id="moonDayValue"></output></label>
        <label class="editor-range">speed <input id="timeSpeed" type="range" min="0" step="1"><output id="timeSpeedValue"></output></label>
        <button id="timeNow" type="button">now</button>
      </div>
      <button id="graphicsButton" type="button" popovertarget="graphics" hidden>graphics</button>
      <div id="graphics" class="editor-popover" popover>
        <h3>Resolution</h3>
        <div id="graphicsResolution"></div>
        <h3>Draw</h3>
        <div id="graphicsParts"></div>
        <label class="editor-check" title="Draws every tree crown as its cheapest, far-away stage"><input id="solidCanopies" type="checkbox"><span>solid canopies</span></label>
        <h3>Ground clutter</h3>
        <label class="editor-range">radius <input id="clutterRadius" type="range" step="10"><output id="clutterRadiusValue"></output></label>
        <label class="editor-range">density <input id="clutterDensity" type="range" min="10" max="100" step="5"><output id="clutterDensityValue"></output></label>
      </div>
    </nav>
    <div class="editor-stage">
      <canvas id="map" class="editor-map"></canvas>
      <canvas id="scene" class="editor-map" hidden></canvas>
      <canvas id="overview" class="editor-map" hidden></canvas>
      <canvas id="sculpt" class="editor-map" hidden></canvas>
      <canvas id="detail" class="editor-map" hidden></canvas>
    </div>
  </div>
  <aside class="editor-panel">
    <section>
      <h2>Continent</h2>
      <select id="continent"></select>
    </section>
    <nav class="editor-step-tabs">
      <button type="button" class="editor-step-head" data-step="heights">heights</button>
      <button type="button" class="editor-step-head" data-step="water">water</button>
      <button type="button" class="editor-step-head" data-step="biomes">biomes</button>
      <button type="button" class="editor-step-head" data-step="civilization">civilization</button>
      <button type="button" class="editor-step-head" data-step="zones">zones</button>
      <button type="button" class="editor-step-head" data-step="tiles">tiles</button>
      <button type="button" class="editor-step-head" data-step="detail">detail</button>
      <button type="button" class="editor-step-head" data-step="3d">3d</button>
      <button id="openLibrary" type="button" class="editor-step-head" title="the world's object library (also on its own at /objects)">objects</button>
    </nav>
    <hr class="editor-divider">
    <div class="editor-steps">
      <section class="editor-step" data-step="heights">
        <div class="editor-step-body">
          <div class="editor-tools" data-tools="heights"></div>
          <label class="editor-range">brush <input id="brushSize" type="range" min="32" max="4096" step="32" value="256"><output id="brushSizeValue"></output></label>
          <label class="editor-range">strength <input id="brushStrength" type="range" min="5" max="500" step="5" value="60"><output id="brushStrengthValue"></output></label>
          <label class="editor-field" data-for="set">set to (ft) <input id="setHeight" type="number" step="10" value="0"></label>
          <label class="editor-field" data-for="terrace">steps every (ft) <input id="terraceStep" type="number" min="1" step="5" value="50"></label>
          <label class="editor-field" data-for="stamp">shape <select id="stampShape"></select></label>
          <label class="editor-field" data-for="stamp">blend <select id="stampBlend"></select></label>
          <label class="editor-field" data-for="stamp">height (ft) <input id="stampHeight" type="number" step="10" value="200"></label>
          <label class="editor-field" data-for="erode">by <select id="erosionKind"></select></label>
          <label class="editor-field" data-for="erode">slumps past (°) <input id="talus" type="number" min="5" max="85" step="5" value="35"></label>
          <label class="editor-check"><input type="checkbox" data-option="heat" checked><span>heat map</span></label>
          <label class="editor-check"><input type="checkbox" data-option="contours" checked><span>contour lines</span></label>
          <label class="editor-check"><input type="checkbox" data-option="grid"><span>32ft grid</span></label>
          <p id="landStatus"></p>
          <div class="editor-row">
            <button id="commitLand" type="button">commit</button>
            <button id="discardLand" type="button">discard</button>
          </div>
          <div class="editor-row">
            <button id="exportHeightmap" type="button" title="the land as a 16-bit grayscale heightmap">export png</button>
            <button id="importHeightmap" type="button" title="a 16-bit grayscale heightmap, from here or another tool">import png</button>
          </div>
          <input id="heightmapFile" type="file" accept="image/png" hidden>
          <div class="editor-row">
            <button id="importBones" type="button" title="a bones file: the land written as a list of operations (script/bones.mjs ops lists them)">import bones</button>
          </div>
          <input id="bonesFile" type="file" accept=".json,application/json" hidden>
        </div>
      </section>
      <section class="editor-step" data-step="water">
        <div class="editor-step-body">
          <div class="editor-tools" data-tools="water"></div>
          <p class="editor-empty">Water runs down from each source, filling hollows until it spills or reaches the sea.</p>
          <label class="editor-check"><input type="checkbox" data-option="tiles"><span>display tiles</span></label>
          <label class="editor-check"><input type="checkbox" data-option="boundaries" checked><span>zone boundaries</span></label>
        </div>
      </section>
      <section class="editor-step" data-step="biomes">
        <div class="editor-step-body">
          <div class="editor-tools" data-tools="biomes"></div>
          <div id="biomePalette" class="editor-palette">
            <div id="biomeChoices" class="editor-choices"></div>
            <div id="biomeTags" class="editor-choices"></div>
          </div>
          <label class="editor-check"><input type="checkbox" data-option="rivers"><span>show rivers</span></label>
          <label class="editor-check"><input type="checkbox" data-option="tiles"><span>display tiles</span></label>
          <label class="editor-check"><input type="checkbox" data-option="boundaries" checked><span>zone boundaries</span></label>
        </div>
      </section>
      <section class="editor-step" data-step="civilization">
        <div class="editor-step-body">
          <div class="editor-tools" data-tools="civilization"></div>
          <label class="editor-check"><input type="checkbox" data-option="heightmap"><span>display height map</span></label>
          <label class="editor-check"><input type="checkbox" data-option="tiles"><span>display tiles</span></label>
          <label class="editor-check"><input type="checkbox" data-option="boundaries" checked><span>zone boundaries</span></label>
        </div>
      </section>
      <section class="editor-step" data-step="zones">
        <div class="editor-step-body">
          <ul id="zoneList" class="editor-zones"></ul>
          <button id="newZone" type="button">new zone</button>
          <div id="zoneEdit" class="editor-step-body" hidden>
            <label class="editor-field">name <input id="zoneName" type="text"></label>
            <p id="regionInfo"></p>
            <div class="editor-row">
              <button id="drawRegion" type="button">draw region</button>
              <button id="deleteZone" type="button">delete zone</button>
            </div>
          </div>
          <label class="editor-check"><input type="checkbox" data-option="heightmap" checked><span>display height map</span></label>
          <label class="editor-check"><input type="checkbox" data-option="tiles"><span>display tiles</span></label>
        </div>
      </section>
      <section class="editor-step" data-step="tiles">
        <div class="editor-step-body">
          <p id="tilesInfo"></p>
          <button id="generate" type="button">generate</button>
          <button id="regenerateAll" type="button">regenerate every tile</button>
          <label class="editor-check"><input type="checkbox" data-option="stale" checked><span>highlight out-of-date tiles</span></label>
          <label class="editor-check"><input type="checkbox" data-option="boundaries" checked><span>zone boundaries</span></label>
        </div>
      </section>
      <section class="editor-step" data-step="detail">
        <div class="editor-step-body">
          <label class="editor-field">window <select id="detailSize"></select></label>
          <p id="detailInfo"></p>
          <button id="detailPick" type="button" title="pick where on the map to edit (F)">move to another spot</button>
          <div class="editor-tools" data-tools="detail"></div>
          <label class="editor-range" data-for="raise lower flatten smooth noise erode">brush <input id="detailRadius" type="range" min="0" max="256" step="4" value="32"><output id="detailRadiusValue"></output></label>
          <label class="editor-range" data-for="raise lower flatten smooth noise erode">falloff <input id="detailFalloff" type="range" min="0" max="200" step="5" value="50"><output id="detailFalloffValue"></output></label>
          <label class="editor-range" data-for="raise lower flatten smooth noise erode">strength <input id="detailStrength" type="range" min="1" max="100" step="1" value="10"><output id="detailStrengthValue"></output></label>
          <label class="editor-field" data-for="erode">by <select id="detailErosion"></select></label>
          <label class="editor-field" data-for="erode">slumps past (°) <input id="detailTalus" type="number" min="5" max="85" step="5" value="35"></label>
          <label class="editor-field" data-for="trails">kind <select id="trailKind"></select></label>
          <label class="editor-field" data-for="trails">state <select id="trailState"></select></label>
          <label class="editor-range" data-for="trails">width <input id="trailWidth" type="range" min="2" max="40" step="1" value="6"><output id="trailWidthValue"></output></label>
          <label class="editor-range" data-for="channel">width <input id="channelWidth" type="range" min="2" max="40" step="1" value="6"><output id="channelWidthValue"></output></label>
          <label class="editor-range" data-for="channel">depth <input id="channelDepth" type="range" min="0.5" max="20" step="0.5" value="3"><output id="channelDepthValue"></output></label>
          <label class="editor-range" data-for="water">flow <input id="sourceFlow" type="range" min="0.5" max="200" step="0.5" value="5"><output id="sourceFlowValue"></output></label>
          <div data-for="water">
            <div id="sourcePanel" class="editor-stack" hidden>
              <p id="sourceInfo"></p>
              <label class="editor-range">flow <input id="pickedFlow" type="range" min="0.5" max="200" step="0.5" value="5"><output id="pickedFlowValue"></output></label>
              <div class="editor-row">
                <button id="sourceFree" type="button">let it run past the window</button>
                <button id="sourceRemove" type="button">remove</button>
              </div>
            </div>
          </div>
          <label class="editor-field" data-for="paint">paint <select id="paintTerrain"></select></label>
          <label id="treeKindRow" class="editor-field" data-for="paint">kind <select id="treeKind"></select></label>
          <label id="treeSizeRow" class="editor-field" data-for="paint">size <select id="treeSize"></select></label>
          <label class="editor-range" data-for="paint">brush <input id="paintRadius" type="range" min="0" max="48" step="4" value="0"><output id="paintRadiusValue"></output></label>
          <label class="editor-field" data-for="place">object <select id="placeType"></select></label>
          <label id="placeSizeRow" class="editor-range" data-for="place">size <input id="placeScale" type="range" min="1" max="100" step="0.5" value="5"><output id="placeScaleValue"></output></label>
          <div class="editor-row" data-for="place"><button id="replaceOpen" type="button">replace every…</button></div>
          <div data-for="objects place">
            <div id="objectPanel" class="editor-stack" hidden>
              <p id="objectInfo"></p>
              <label class="editor-range">turn <input id="objectYaw" type="range" min="0" max="355" step="5" value="0"><output id="objectYawValue"></output></label>
              <label id="objectSizeRow" class="editor-range">size <input id="objectScale" type="range" min="1" max="100" step="0.5" value="5"><output id="objectScaleValue"></output></label>
              <div id="objectBaseRow" class="editor-row" hidden title="shift-click for a quarter foot">ground floor <button id="objectLower" type="button">▼</button><output id="objectBaseValue"></output><button id="objectRaise" type="button">▲</button></div>
              <div id="objectColors" class="editor-row editor-wrap"></div>
              <div id="objectTexts" class="editor-stack"></div>
              <button id="objectDelete" type="button">delete</button>
            </div>
          </div>
        </div>
      </section>
      <section class="editor-step" data-step="3d">
        <div class="editor-step-body">
          <p id="overviewInfo"></p>
          <label class="editor-range">heights × <input id="exaggeration" type="range" min="1" max="4" step="0.5" value="1"><output id="exaggerationValue">1</output></label>
        </div>
      </section>
    </div>
    <section id="props" class="editor-props" hidden></section>
    <p id="message" class="editor-message"></p>
    <p id="hint" class="editor-hint"></p>
  </aside>
</main>
<dialog id="replaceDialog" class="editor-popover replace-dialog">
  <h3>Replace placed objects</h3>
  <label class="editor-field">replace every placed <select id="replaceFrom"></select></label>
  <label class="editor-field">with <select id="replaceTo"></select></label>
  <div class="editor-row"><button id="replaceObjects" type="button">replace them</button><button id="replaceCancel" type="button">cancel</button></div>
</dialog>
<dialog id="libraryPopover" class="library-popover">
  <div class="library-bar"><h2>Objects</h2><a href="/objects" target="_blank">open on its own</a><span class="library-spacer"></span><p class="editor-message library-message"></p><button type="button" class="library-close">close</button></div>
  <div id="libraryGallery" class="editor-gallery"></div>
</dialog>
