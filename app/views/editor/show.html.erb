<header class="editor-bar">
  <strong id="worldName"></strong>
  <span id="cursor" class="editor-cursor"></span>
  <span class="spacer"></span>
  <button id="newWorld" type="button">new world</button>
  <button id="upload" type="button">upload world</button>
  <button id="loadDefault" type="button" title="Loads the shared default world from this server">load default</button>
  <input id="uploadFile" type="file" accept=".zip,application/zip" hidden>
  <button id="download" type="button">download world</button>
</header>
<main class="editor-main">
  <div class="editor-view">
    <nav class="editor-tabs editor-view-bar">
      <span id="viewTabs" class="editor-tabs">
        <button type="button" data-view="cells">cells</button>
        <button type="button" data-view="terrain">terrain</button>
        <button type="button" data-view="3d">3D</button>
      </span>
      <button id="walk" type="button" hidden>walk</button>
      <button id="graphicsButton" type="button" popovertarget="graphics" hidden>graphics</button>
      <div id="graphics" class="editor-popover" popover>
        <h3>Resolution</h3>
        <div id="graphicsResolution"></div>
        <h3>Draw</h3>
        <div id="graphicsParts"></div>
        <label class="editor-check" title="Draws every tree crown as its cheapest, far-away stage"><input id="solidCanopies" type="checkbox"><span>solid canopies</span></label>
        <h3>Ground clutter</h3>
        <label class="editor-range">radius <input id="clutterRadius" type="range" step="10"><output id="clutterRadiusValue"></output></label>
        <label class="editor-range">density <input id="clutterDensity" type="range" min="10" max="100" step="5"><output id="clutterDensityValue"></output></label>
      </div>
      <span class="spacer"></span>
      <label class="editor-check"><input id="showBiomes" type="checkbox"><span>show biomes</span></label>
      <label class="editor-check"><input id="showPins" type="checkbox" checked><span>show pins</span></label>
    </nav>
    <div class="editor-stage">
      <canvas id="map" class="editor-map"></canvas>
      <canvas id="scene" class="editor-map" hidden></canvas>
      <div id="sceneTip" class="editor-tip" hidden></div>
    </div>
  </div>
  <aside class="editor-panel">
    <section>
      <h2>Continent</h2>
      <select id="continent"></select>
    </section>
    <section>
      <h2>Zones</h2>
      <ul id="zoneList" class="editor-zones"></ul>
      <button id="newZone" type="button">new zone</button>
    </section>
    <nav id="stepTabs" class="editor-tabs editor-steps">
      <button type="button" data-step="zones">zones</button>
      <button type="button" data-step="shape">shape</button>
      <button type="button" data-step="features">features</button>
      <button type="button" data-step="population">population</button>
    </nav>
    <p id="noZone" class="editor-empty">pick a zone to edit, or make a new one</p>
    <section class="editor-step" data-step="zones" hidden>
      <label class="editor-field">name <input id="zoneName" type="text"></label>
      <p id="regionInfo"></p>
      <div class="editor-row">
        <button id="drawRegion" type="button">draw region</button>
        <button id="deleteZone" type="button">delete zone</button>
      </div>
    </section>
    <section class="editor-step" data-step="shape" hidden>
      <div class="editor-tools" data-tools="shape"></div>
      <div id="heightPalette" class="editor-palette" hidden>
        <input id="heightSlider" class="editor-vslider" type="range" min="-180" max="1000" step="1" value="0">
        <div>
          <strong id="heightValue"></strong>
          <p class="editor-empty">4 miles (21,120 ft) at the top, -50 at the bottom</p>
        </div>
      </div>
      <div id="biomePalette" class="editor-palette" hidden>
        <div id="biomeChoices" class="editor-choices"></div>
        <div id="biomeTags" class="editor-choices"></div>
      </div>
      <div class="editor-row editor-subhead editor-show">
        show
        <label class="editor-check"><input type="radio" name="shapeShow" value="both" checked><span>both</span></label>
        <label class="editor-check"><input type="radio" name="shapeShow" value="biomes"><span>biomes</span></label>
        <label class="editor-check"><input type="radio" name="shapeShow" value="heights"><span>heights</span></label>
      </div>
      <label class="editor-check"><input id="showRivers" type="checkbox"><span>show rivers</span></label>
      <div class="editor-row editor-subhead">
        <button id="generate" type="button">generate</button>
        <button id="regenerate" type="button">regenerate changed</button>
      </div>
      <label class="editor-check">
        <input id="highlight" type="checkbox">
        <span>highlight changes (<span id="pendingInfo"></span>)</span>
      </label>
    </section>
    <section class="editor-step" data-step="features" hidden>
      <div class="editor-tools" data-tools="features"></div>
    </section>
    <section class="editor-step" data-step="population" hidden>
      <div class="editor-tools" data-tools="population"></div>
      <label class="editor-field editor-subhead">tree kind <select id="treeKind"></select></label>
    </section>
    <section id="props" class="editor-props" hidden></section>
    <p id="message" class="editor-message"></p>
    <p id="hint" class="editor-hint"></p>
  </aside>
</main>
