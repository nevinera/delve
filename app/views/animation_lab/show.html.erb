<% content_for :title, "Animation lab - Delve" %>
<canvas id="stage" class="builder-stage"></canvas>
<aside class="builder-panel lab-panel" id="lab" data-characters="<%= @characters.to_json %>">
  <section class="builder-config">
    <h1>Animation lab</h1>
    <label class="builder-row"><span>clip</span><select id="clip"></select></label>
    <label class="builder-row"><span>time</span><input id="time" type="range" min="0" max="1" step="0.001" value="0"><output id="timeValue"></output></label>
    <label class="builder-row"><span>speed</span><input id="speed" type="range" min="0.05" max="2" step="0.05" value="1"><output id="speedValue">1.00×</output></label>
    <label class="builder-row"><span>loop</span><input id="loop" type="checkbox" checked></label>
    <div class="lab-buttons">
      <button id="restart" type="button">restart</button>
      <button id="back" type="button">◀ frame</button>
      <button id="play" type="button">pause</button>
      <button id="forward" type="button">frame ▶</button>
    </div>
    <h2>View</h2>
    <div id="views" class="lab-buttons"></div>
    <h2>Character</h2>
    <div id="controls"></div>
    <p class="lab-help">space plays and pauses; the arrow keys step a frame. Drag to turn the view, scroll to zoom.</p>
  </section>
</aside>
