<li>
  <canvas class="character-picture" data-look="<%= character.look.to_json %>"></canvas>
  <div class="character-about">
    <strong><%= character.name %></strong>
    <div class="character-actions">
      <%= link_to "edit", edit_character_path(character) %>
    </div>
  </div>
  <% worlds = local_assigns[:played]&.fetch(character.id, []) || [] %>
  <% if worlds.any? %>
    <div class="character-worlds">
      <% worlds.each do |world| %>
        <%= link_to world.display_name, play_path(world, character: character.id), role: "button", class: "secondary", title: "Play #{world.display_name} as #{character.name}" %>
      <% end %>
    </div>
  <% end %>
</li>
