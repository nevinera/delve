<li>
  <canvas class="character-picture" data-look="<%= character.look.to_json %>"></canvas>
  <div class="character-about">
    <strong><%= character.name %></strong>
    <div class="character-actions">
      <%= link_to "edit", edit_character_path(character) %>
      <%= button_to "delete", character_path(character), method: :delete, class: "compact secondary", form: {data: {turbo_confirm: "Delete #{character.name}? This can't be undone."}} %>
    </div>
  </div>
</li>
