<% content_for :title, "Monster lab - Delve" %>
<main class="monster-lab">
  <nav id="bodies" class="monster-bodies" aria-label="bodies"></nav>
  <div class="monster-view">
    <canvas id="stage" class="monster-stage"></canvas>
    <div id="now" class="monster-now"></div>
  </div>
  <aside class="monster-panel">
    <h1>Monster lab</h1>
    <label class="monster-row"><span>clip</span><select id="clip"></select></label>
    <label class="monster-row"><span>time</span><input id="time" type="range" min="0" max="1" step="0.001" value="0"><output id="timeValue"></output></label>
    <label class="monster-row"><span>speed</span><input id="speed" type="range" min="0.05" max="2" step="0.05" value="1"><output id="speedValue">1.00×</output></label>
    <label class="monster-row"><span>loop</span><input id="loop" type="checkbox" checked></label>
    <label class="monster-row"><span>every clip</span><input id="cycle" type="checkbox"></label>
    <div class="monster-buttons">
      <button id="restart" type="button">restart</button>
      <button id="back" type="button">◀ frame</button>
      <button id="play" type="button">pause</button>
      <button id="forward" type="button">frame ▶</button>
    </div>
    <h2>Looks</h2>
    <label class="monster-row"><span>how many</span><input id="count" type="range" min="1" max="6" step="1" value="4"><output id="countValue">4</output></label>
    <label class="monster-row"><span>loadouts</span><select id="loadouts"><option value="each">one each, in turn</option><option value="random">picked by weight</option><option value="none">nothing</option></select></label>
    <div class="monster-buttons">
      <button id="reroll" type="button">new looks</button>
    </div>
    <div id="looks" class="monster-looks"></div>
    <h2>View</h2>
    <div id="views" class="monster-buttons"></div>
    <p class="monster-help">Up and down pick a body; left and right step a frame; space plays and pauses. Drag to turn the view, scroll to zoom.</p>
  </aside>
</main>
